<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customer Payment Display | Koumiya Ramen</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="[background:radial-gradient(circle_at_center,_#fff7ed_0%,_#fef3c7_50%,_#f5f5f4_100%)] h-screen w-screen p-2 md:p-4 font-sans select-none overflow-hidden flex flex-col justify-center items-center">

  <!-- Main Container: Full screen fitting iPad Pro / iPad (Zero black bars) -->
  <div class="w-full h-full bg-white border-4 border-stone-800 ring-4 ring-amber-200/50 p-4 md:p-8 relative flex flex-col justify-between items-center text-center shadow-2xl rounded-2xl overflow-hidden flex-1">
    
    <!-- Top Bar: Brand, Table Switcher (for demo), Live Sync -->
    <div class="w-full flex justify-between items-center border-b-2 border-stone-200 pb-3 shrink-0">
      <div class="flex items-center gap-2">
        <span class="text-2xl md:text-3xl">ศLOGO</span>
        <span class="font-black text-base md:text-xl tracking-wide text-stone-800">Koumiya Ramen</span>
      </div>
    </div>

    <!-- Center Content: Matching pay.png exactly (Table Number + QR/Cash Status + Total Amount) -->
    <div class="flex-1 w-full flex flex-col justify-center items-center my-auto py-2 overflow-hidden min-h-0">
      
      <!-- 1. Table Number (เช่น "โต๊ะ 1" หรือ "โต๊ะ 5") -->
      <h1 id="display-table-text" class="text-5xl md:text-7xl font-black text-stone-800 tracking-tight mb-2 md:mb-4 shrink-0">
        โต๊ะ 1
      </h1>

      <!-- 2. Transfer Mode: แสดงคำว่า qrจ่าย + Mock QR Code ขนาดใหญ่ (เมื่อกดโอน) -->
      <div id="qr-section" class="hidden flex flex-col items-center justify-center my-auto">
        <div class="w-52 h-52 md:w-72 md:h-72 bg-white border-4 border-stone-800 rounded-2xl p-2 md:p-3 shadow-lg flex items-center justify-center">
          <img src="/images/mock-qr.svg" alt="Mock QR Code" class="w-full h-full object-contain">
        </div>
      </div>

      <!-- 3. Cash Mode: เมื่อเลือกชำระด้วยเงินสด (ไม่ต้องโชว์ QR) -->
      <div id="cash-section" class="flex flex-col items-center justify-center my-auto">
        <div class="text-2xl md:text-3xl font-black text-stone-800">
          ชำระด้วยเงินสด (CASH)
        </div>
      </div>

      <!-- 4. Standby Mode: กรณีไม่มีรายการค้างชำระ -->
      <div id="standby-section" class="hidden flex flex-col items-center justify-center my-auto">
        <div class="text-2xl md:text-3xl font-black text-stone-800">
          Koumiya Ramen ยินดีต้อนรับ
        </div>
      </div>

      <!-- 5. Total Amount (ยอดเงิน: 120 ฿ / 600 ฿) -->
      <div id="amount-section" class="shrink-0 mt-3 md:mt-4">
        <div class="text-2xl md:text-4xl font-bold text-stone-700">
          ยอดเงิน
        </div>
        <div class="text-5xl md:text-7xl font-black text-orange-600 tracking-tight mt-0.5">
          <span id="display-amount">0</span> ฿
        </div>
      </div>

    </div>

  </div>

  <script>
    let currentTableId = <%= currentTableId %>;
    let paymentMode = 'CASH'; // 'CASH' or 'TRANSFER'

    // ฟังก์ชันจัดรูปแบบเลขโต๊ะให้เป็นภาษาไทย เช่น 'T01' -> 'โต๊ะ 1', 'T05' -> 'โต๊ะ 5'
    function formatTableNumber(rawStr) {
      if (!rawStr) return 'โต๊ะ -';
      const cleanNum = parseInt(String(rawStr).replace(/\D/g, ''), 10);
      return isNaN(cleanNum) ? `โต๊ะ ${rawStr}` : `โต๊ะ ${cleanNum}`;
    }

    function setPaymentMode(mode) {
      paymentMode = mode;
      const qrSection = document.getElementById('qr-section');
      const cashSection = document.getElementById('cash-section');

      if (paymentMode === 'TRANSFER') {
        qrSection.classList.remove('hidden');
        cashSection.classList.add('hidden');
      } else {
        qrSection.classList.add('hidden');
        cashSection.classList.remove('hidden');
      }
    }

    // BroadcastChannel รับข้อความจากหน้าแคชเชียร์แบบ Real-time (0ms)
    const cashierBc = new BroadcastChannel('cashier_display_sync');
    cashierBc.onmessage = (event) => {
      if (event.data && event.data.type === 'PAYMENT_METHOD') {
        if (event.data.table_id) {
          currentTableId = event.data.table_id;
          const selectEl = document.getElementById('table-select');
          if (selectEl) selectEl.value = currentTableId;
        }
        setPaymentMode(event.data.payment_method || 'CASH');
        fetchCustomerBill();
      }
    };

    // localStorage Listener รับข้อความข้ามหน้าต่าง / ข้ามแท็บ
    window.addEventListener('storage', (e) => {
      if (e.key === 'cashier_display_state' && e.newValue) {
        try {
          const data = JSON.parse(e.newValue);
          if (data.table_id) {
            currentTableId = data.table_id;
            const selectEl = document.getElementById('table-select');
            if (selectEl) selectEl.value = currentTableId;
          }
          setPaymentMode(data.payment_method || 'CASH');
          fetchCustomerBill();
        } catch (err) {}
      }
    });

    function changeDisplayTable(tableId) {
      currentTableId = parseInt(tableId, 10);
      fetchCustomerBill();
    }

    // ดึงข้อมูลบิลของโต๊ะปัจจุบันจาก Server (ไม่ใช้ innerHTML เด็ดขาด)
    function fetchCustomerBill() {
      fetch(`/cashier/api/table-bill?table_id=${currentTableId}`)
        .then(res => res.json())
        .then(data => {
          const tableTitleEl = document.getElementById('display-table-text');
          const amountEl = document.getElementById('display-amount');
          const standbySection = document.getElementById('standby-section');
          const qrSection = document.getElementById('qr-section');
          const cashSection = document.getElementById('cash-section');
          const amountSection = document.getElementById('amount-section');

          if (data.success && data.table_number) {
            tableTitleEl.textContent = formatTableNumber(data.table_number);
            amountEl.textContent = data.grand_total;

            if (data.cashier_state && data.cashier_state.payment_method) {
              setPaymentMode(data.cashier_state.payment_method);
            }

            if (data.items && data.items.length > 0) {
              standbySection.classList.add('hidden');
              amountSection.classList.remove('hidden');
              if (paymentMode === 'TRANSFER') {
                qrSection.classList.remove('hidden');
                cashSection.classList.add('hidden');
              } else {
                qrSection.classList.add('hidden');
                cashSection.classList.remove('hidden');
              }
            } else {
              // กรณีโต๊ะนี้ไม่มีรายการค้างชำระ
              standbySection.classList.remove('hidden');
              qrSection.classList.add('hidden');
              cashSection.classList.add('hidden');
              amountEl.textContent = '0';
            }
          } else {
            tableTitleEl.textContent = `โต๊ะ ${currentTableId}`;
            amountEl.textContent = '0';
            standbySection.classList.remove('hidden');
            qrSection.classList.add('hidden');
            cashSection.classList.add('hidden');
          }
        })
        .catch(err => console.error('Fetch customer display error:', err));
    }

    // ดึงสถานะเริ่มต้น
    setPaymentMode('CASH');
    fetchCustomerBill();
    // Auto-sync polling ทุก 2.5 วินาที
    setInterval(fetchCustomerBill, 2500);
  </script>
</body>
</html>