<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>เคาน์เตอร์แคชเชียร์ (Cashier) | IsadRamen</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: { fontFamily: { sans: ['Prompt', 'sans-serif'] } }
      }
    }
  </script>
</head>
<body class="bg-gradient-to-br from-[#fff7ed] via-[#fef3c7] to-[#f5f5f4] min-h-screen flex items-center justify-center p-4 select-none text-[#4a3728] font-sans">

  <!-- Main POS Container -->
  <div class="w-full max-w-[1200px] h-[820px] bg-white border-2 border-[#4a3728] rounded-[28px] p-5 flex flex-col justify-between relative shadow-[0_10px_25px_-5px_rgba(74,55,40,0.06)]">
    
    <!-- Header -->
    <div class="flex items-center pb-2 gap-3">
      <div class="w-12 h-12 rounded-2xl border-2 border-[#4a3728] bg-[#fef3c7] flex items-center justify-center text-2xl shadow-[0_2px_0_#4a3728]">💳</div>
      <h1 class="text-2xl font-black text-[#4a3728]">ระบบแคชเชียร์</h1>
      <span class="bg-[#fef3c7] text-[#a46700] text-xs font-extrabold px-3 py-1 rounded-full border border-[#fde68a]">IsadRamen POS</span>
    </div>

    <!-- 3 Columns Layout -->
    <div class="grid grid-cols-[185px_1fr_345px] gap-4 flex-1 min-h-0 mt-2">
      
      <!-- Col 1: เลือกโต๊ะ -->
      <div class="border-2 border-[#4a3728] rounded-[20px] p-3.5 flex flex-col justify-between min-h-0 bg-[#fffdfa]">
        <div class="flex flex-col flex-1 min-h-0">
          <div class="text-center mb-2 font-black text-sm">เลือกโต๊ะ</div>
          <div id="tables-grid" class="grid grid-cols-2 gap-2 flex-1 min-h-0"></div>
        </div>
        <div class="mt-2.5 flex flex-col gap-2">
          <div class="flex justify-between items-center px-1">
            <button onclick="changePage(-1)" id="table-prev-btn" class="w-8 h-[30px] border-2 border-[#4a3728] rounded-lg bg-white text-[#4a3728] font-extrabold text-xs flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none disabled:opacity-40 disabled:cursor-not-allowed transition cursor-pointer">&lt;</button>
            <span id="table-page-indicator" class="text-xs font-black">1 / 2</span>
            <button onclick="changePage(1)" id="table-next-btn" class="w-8 h-[30px] border-2 border-[#4a3728] rounded-lg bg-white text-[#4a3728] font-extrabold text-xs flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none disabled:opacity-40 disabled:cursor-not-allowed transition cursor-pointer">&gt;</button>
          </div>
          <button onclick="toggleModal('scan-modal', true)" class="w-full h-[42px] bg-gradient-to-r from-[#fef3c7] to-[#ffedd5] border-2 border-[#4a3728] rounded-[14px] font-black text-xs text-[#4a3728] flex items-center justify-center gap-2 shadow-[0_2px_0_#4a3728] hover:from-[#fef08a] hover:to-[#fde68a] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">
            <span>💳</span><span>สแกนการ์ด</span>
          </button>
        </div>
      </div>

      <!-- Col 2: รายการอาหาร -->
      <div class="border-2 border-[#4a3728] rounded-[20px] p-3.5 flex flex-col justify-between min-h-0 bg-[#fffdfa]">
        <div class="flex flex-col flex-1 min-h-0">
          <div class="flex items-center justify-center gap-1.5 mb-2 font-black text-sm">
            <span>📋</span><span id="table-title">รายการอาหาร (เลือกโต๊ะ)</span>
          </div>
          <div class="flex-1 border-2 border-[#4a3728] rounded-2xl overflow-hidden flex flex-col min-h-0 bg-white">
            <table class="w-full h-full border-collapse table-fixed text-xs text-center">
              <thead>
                <tr class="bg-[#fef3c7] text-[#4a3728] font-extrabold h-[38px] border-b-2 border-[#4a3728]">
                  <th class="w-[50px] border-r border-[#4a3728]">ลำดับ</th>
                  <th class="text-left pl-3.5 border-r border-[#4a3728]">รายการ</th>
                  <th class="w-[44%] text-left pl-3.5 border-r border-[#4a3728]">การปรับแต่ง</th>
                  <th class="w-[55px] border-r border-[#4a3728]">จำนวน</th>
                  <th class="w-[65px]">ราคา</th>
                </tr>
              </thead>
              <tbody id="bill-tbody"></tbody>
            </table>
          </div>
        </div>
        <!-- ปรับปรุงจุดที่ 2: Padding ไม่ชิดหน้าหลังเกินไป -->
        <div class="border-2 border-[#4a3728] rounded-[14px] py-2.5 px-7 mt-3 flex justify-between items-center bg-[#fffbeb] shadow-[0_1.5px_0_#4a3728]">
          <span class="font-black text-sm text-[#4a3728]">ยอดรวมโต๊ะนี้:</span>
          <span class="font-black text-2xl text-[#ea580c]"><span id="col2-grand-total">0</span> ฿</span>
        </div>
      </div>

      <!-- Col 3: ชำระเงิน -->
      <div class="border-2 border-[#4a3728] rounded-[20px] p-3.5 flex flex-col justify-between min-h-0 bg-[#fffdfa]">
        <div class="flex flex-col justify-between h-full">
          <div>
            <div class="text-center mb-1 font-black text-sm">จัดการชำระเงิน</div>
            <div class="border-2 border-[#4a3728] rounded-[18px] py-2 px-3 text-center my-2 mb-3 bg-[#fffbeb] shadow-[0_1.5px_0_#4a3728]">
              <span class="text-[11px] font-extrabold text-[#716155] block">ยอดรวมทั้งสิ้น (TOTAL)</span>
              <span id="col3-grand-total" class="text-3xl font-black text-[#ea580c] leading-tight">0 ฿</span>
            </div>

            <div class="flex gap-2 mb-2.5">
              <button onclick="setPaymentMethod('TRANSFER')" id="btn-transfer" class="flex-1 h-10 rounded-xl font-black text-xs flex items-center justify-center gap-1.5 shadow-[0_2px_0_#4a3728] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer border-2 border-[#4a3728] bg-[#f0f9ff] text-[#0284c7]">📱 โอน (QR)</button>
              <button onclick="setPaymentMethod('CASH')" id="btn-cash" class="flex-1 h-10 rounded-xl font-black text-xs flex items-center justify-center gap-1.5 shadow-[0_2px_0_#4a3728] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer border-2 border-[#047857] bg-[#10b981] text-white">💵 เงินสด (CASH)</button>
            </div>

            <div id="cash-mode" class="flex flex-col gap-1.5">
              <div class="border border-[#dfd5c6] bg-white rounded-xl py-2 px-3.5 flex justify-between items-center transition hover:bg-[#fffdf0] hover:border-[#facc15]">
                <span class="text-xs font-extrabold text-[#544437]">รับเงินสด:</span>
                <span id="display-amount-paid" class="text-[15px] font-black">0 ฿</span>
              </div>
              <div class="border border-[#dfd5c6] bg-white rounded-xl py-2 px-3.5 flex justify-between items-center transition hover:bg-[#fffdf0] hover:border-[#facc15]">
                <span class="text-xs font-extrabold text-[#544437]">ทอนเงิน:</span>
                <span id="display-change" class="text-[15px] font-black text-[#10b981]">0 ฿</span>
              </div>
              
              <div class="grid grid-cols-3 gap-2 mt-2">
                <button onclick="pressKey('1')" class="h-12 bg-white border-2 border-[#4a3728] rounded-[14px] text-xl font-extrabold text-[#4a3728] flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">1</button>
                <button onclick="pressKey('2')" class="h-12 bg-white border-2 border-[#4a3728] rounded-[14px] text-xl font-extrabold text-[#4a3728] flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">2</button>
                <button onclick="pressKey('3')" class="h-12 bg-white border-2 border-[#4a3728] rounded-[14px] text-xl font-extrabold text-[#4a3728] flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">3</button>
                <button onclick="pressKey('4')" class="h-12 bg-white border-2 border-[#4a3728] rounded-[14px] text-xl font-extrabold text-[#4a3728] flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">4</button>
                <button onclick="pressKey('5')" class="h-12 bg-white border-2 border-[#4a3728] rounded-[14px] text-xl font-extrabold text-[#4a3728] flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">5</button>
                <button onclick="pressKey('6')" class="h-12 bg-white border-2 border-[#4a3728] rounded-[14px] text-xl font-extrabold text-[#4a3728] flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">6</button>
                <button onclick="pressKey('7')" class="h-12 bg-white border-2 border-[#4a3728] rounded-[14px] text-xl font-extrabold text-[#4a3728] flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">7</button>
                <button onclick="pressKey('8')" class="h-12 bg-white border-2 border-[#4a3728] rounded-[14px] text-xl font-extrabold text-[#4a3728] flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">8</button>
                <button onclick="pressKey('9')" class="h-12 bg-white border-2 border-[#4a3728] rounded-[14px] text-xl font-extrabold text-[#4a3728] flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">9</button>
                <button onclick="pressKey('.')" class="h-12 bg-white border-2 border-[#4a3728] rounded-[14px] text-xl font-extrabold text-[#4a3728] flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">.</button>
                <button onclick="pressKey('0')" class="h-12 bg-white border-2 border-[#4a3728] rounded-[14px] text-xl font-extrabold text-[#4a3728] flex items-center justify-center shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">0</button>
                <button onclick="pressKey('BACK')" class="h-12 bg-[#fff1f2] border-2 border-[#fb7185] text-[#e11d48] rounded-[14px] text-xl font-extrabold flex items-center justify-center shadow-[0_2px_0_#e11d48] hover:bg-[#ffe4e6] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">ลบ</button>
              </div>

              <!-- ปรับปรุงจุดที่ 2: ปุ่มเงินด่วน ขอบเต็ม ไม่แหว่ง มีเงาสวยงาม -->
              <div class="grid grid-cols-4 gap-1.5 mt-2">
                <button onclick="setExactAmount()" class="h-[38px] bg-[#fef9ee] border-2 border-[#4a3728] rounded-xl text-xs font-extrabold text-[#4a3728] shadow-[0_2px_0_#4a3728] hover:bg-[#fef08a] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">พอดี</button>
                <button onclick="addQuickCash(100)" class="h-[38px] bg-[#fef9ee] border-2 border-[#4a3728] rounded-xl text-xs font-extrabold text-[#4a3728] shadow-[0_2px_0_#4a3728] hover:bg-[#fef08a] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">+100</button>
                <button onclick="addQuickCash(500)" class="h-[38px] bg-[#fef9ee] border-2 border-[#4a3728] rounded-xl text-xs font-extrabold text-[#4a3728] shadow-[0_2px_0_#4a3728] hover:bg-[#fef08a] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">+500</button>
                <button onclick="pressKey('CLEAR')" class="h-[38px] bg-[#fef9ee] border-2 border-[#4a3728] rounded-xl text-xs font-extrabold text-[#4a3728] shadow-[0_2px_0_#4a3728] hover:bg-[#fef08a] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">C</button>
              </div>
            </div>

            <div id="transfer-mode" class="hidden text-center py-3">
              <p class="text-xs font-extrabold">สแกน QR เพื่อชำระเงินผ่าน Mobile Banking</p>
              <div class="w-[135px] h-[135px] mx-auto my-2 border-2 border-[#4a3728] rounded-2xl p-1.5 bg-white shadow-[0_2px_0_#4a3728]">
                <img src="/images/mock-qr.svg" alt="QR" class="w-full h-full object-contain">
              </div>
              <p class="text-[13px] font-black text-[#10b981]">ยอดโอน: <span id="transfer-qr-amount">0</span> ฿</p>
            </div>
          </div>
          <button onclick="confirmPayment()" id="confirm-payment-btn" disabled class="w-full h-[50px] bg-[#ea580c] border-2 border-[#9a3412] rounded-[18px] text-white text-[15px] font-black flex items-center justify-center gap-2 shadow-[0_3px_0_#9a3412] hover:bg-[#c2410c] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none disabled:opacity-45 disabled:cursor-not-allowed disabled:shadow-none transition cursor-pointer">
            ✨ ยืนยันการชำระเงิน
          </button>
        </div>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- MODAL 1: สแกนการ์ด (ปรับปรุงจุดที่ 1 ตามรูป 1) -->
    <!-- ======================================================== -->
    <div id="scan-modal" class="hidden absolute inset-0 bg-[#4a3728]/45 backdrop-blur-[4px] items-center justify-center p-4 z-50">
      <div class="bg-white w-[540px] border-2 border-[#4a3728] rounded-[26px] p-6 shadow-[0_20px_25px_-5px_rgba(74,55,40,0.3)]">
        <div class="flex justify-between items-center mb-3.5">
          <div class="flex items-center gap-2.5">
            <div class="w-10 h-10 rounded-xl border-2 border-[#4a3728] bg-[#fef3c7] flex items-center justify-center text-xl shadow-[0_1.5px_0_#4a3728]">💳</div>
            <h3 class="text-lg font-black">จำลองการสแกน Payment Card</h3>
          </div>
          <button onclick="toggleModal('scan-modal', false)" class="w-7 h-7 rounded-full border-1.5 border-[#4a3728] bg-white font-extrabold cursor-pointer hover:bg-gray-100">✕</button>
        </div>
        <div class="bg-[#fffbeb] border border-[#fde68a] rounded-xl py-2.5 px-3.5 text-xs font-extrabold text-[#a46700] mb-3">
          แตะเลือกการ์ดที่ลูกค้านำมา หรือพิมพ์รหัสการ์ด (CARD-01 ถึง CARD-20):
        </div>
        
        <!-- เอา scroll ตัดเงาออก ให้เห็นเงา CARD-17 ถึง CARD-20 ชัดเจน -->
        <div class="grid grid-cols-4 gap-2.5 mb-4">
          <% for(let i = 1; i <= 20; i++) { const cCode = `CARD-${String(i).padStart(2, '0')}`; %>
            <button onclick="selectCardCode('<%= cCode %>')" class="h-10 border-2 border-[#4a3728] rounded-xl bg-white font-black text-xs text-[#4a3728] shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] transition cursor-pointer"><%= cCode %></button>
          <% } %>
        </div>

        <!-- ช่องพิมพ์และปุ่มค้นหาขนาดกว้างพอดี ไม่เบียด -->
        <div class="flex gap-2.5">
          <input type="text" id="manual-card-input" placeholder="หรือพิมพ์ เช่น CARD-05" class="flex-1 h-11 border-2 border-[#4a3728] rounded-2xl px-4 text-xs font-extrabold outline-none" onkeypress="if(event.key === 'Enter') selectCardCode(this.value)">
          <button onclick="selectCardCode(document.getElementById('manual-card-input').value)" class="w-28 h-11 bg-[#ea580c] border-2 border-[#9a3412] rounded-2xl text-white font-black text-xs shadow-[0_2px_0_#9a3412] hover:bg-[#c2410c] flex items-center justify-center gap-1.5 cursor-pointer transition">
            <span>🔍</span><span>ค้นหา</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- MODAL 2: ใบเสร็จรับเงิน (ปรับปรุงจุดที่ 3 ตามรูป 3) -->
    <!-- ======================================================== -->
    <div id="receipt-modal" class="hidden absolute inset-0 bg-[#4a3728]/45 backdrop-blur-[4px] items-center justify-center p-4 z-[60]">
      <div class="bg-white w-[400px] border-2 border-[#4a3728] rounded-[28px] p-6 flex flex-col gap-2.5 shadow-[0_25px_35px_-5px_rgba(74,55,40,0.35)]">
        
        <div class="text-center border-b-2 border-dashed border-[#4a3728] pb-2">
          <h2 class="font-black text-lg tracking-tight m-0">ISADRAMEN RESTAURANT</h2>
          <p class="text-[11px] font-extrabold text-[#716155] mt-0.5">ใบเสร็จรับเงิน (RECEIPT)</p>
        </div>

        <div class="flex justify-between text-xs font-black">
          <span>TABLE: <strong id="receipt-table" class="text-sm">T05</strong></span>
          <span>CARD: <strong id="receipt-card">CARD-05</strong></span>
        </div>

        <div class="flex justify-between text-[11px] font-bold text-[#8c7a6b] border-b border-dashed border-[#dfd5c6] pb-1.5">
          <span id="receipt-date"></span>
          <span id="receipt-no">#REC-0007</span>
        </div>

        <div id="receipt-items-list" class="max-h-[180px] overflow-y-auto flex flex-col gap-2 border-b-2 border-dashed border-[#4a3728] pb-2.5"></div>

        <div class="flex flex-col gap-1 text-xs border-b-2 border-dashed border-[#4a3728] pb-2.5">
          <div class="flex justify-between font-black text-sm">
            <span>TOTAL:</span><span class="text-[#ea580c] text-[15px]"><span id="receipt-total">0</span> ฿</span>
          </div>
          <div class="flex justify-between font-extrabold"><span>Payment:</span><span id="receipt-method">CASH</span></div>
          <div class="flex justify-between font-extrabold"><span>Paid:</span><span><span id="receipt-paid">0</span> ฿</span></div>
          <div class="flex justify-between font-black text-[#10b981]"><span>Change:</span><span><span id="receipt-change">0</span> ฿</span></div>
        </div>

        <p class="text-center text-[10px] text-[#8c7a6b] font-bold my-0.5">ขอบคุณที่ใช้บริการ / Thank you!</p>

        <div class="flex gap-2.5 mt-1">
          <button type="button" onclick="alert('🖨️ [จำลองการพิมพ์] ใบเสร็จรับเงินถูกส่งไปยังเครื่องพิมพ์เรียบร้อยแล้ว')" class="flex-1 h-10 bg-[#ea580c] border-2 border-[#9a3412] rounded-xl text-white font-black text-xs shadow-[0_2px_0_#9a3412] hover:bg-[#c2410c] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer flex items-center justify-center gap-1.5">
            <span>🖨️</span><span>พิมพ์ใบเสร็จ</span>
          </button>
          <button type="button" onclick="closeReceiptAndReset()" class="flex-1 h-10 bg-white border-2 border-[#4a3728] rounded-xl text-[#4a3728] font-black text-xs shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">
            เสร็จสิ้น (ปิด)
          </button>
        </div>

      </div>
    </div>
  </div>

  <script>
    let allTables = [], currentTablePage = 1, tablesPerPage = 10, selectedTable = null, currentBill = null, paymentMethod = 'CASH', rawAmountPaid = '';
    const cashierBc = new BroadcastChannel('cashier_display_sync');

    function syncToCustomerDisplay(method) {
      const payload = { type: 'PAYMENT_METHOD', table_id: selectedTable?.table_id || null, payment_method: method, show_qr: method === 'TRANSFER' };
      try { cashierBc.postMessage(payload); } catch(e){}
      try { localStorage.setItem('cashier_display_state', JSON.stringify({ ...payload, time: Date.now() })); } catch(e){}
      fetch('/cashier/api/payment-method', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ table_id: payload.table_id, payment_method: method }) }).catch(()=>{});
    }

    function loadTables() {
      fetch('/cashier/api/tables').then(r=>r.json()).then(d => { if(d.success) { allTables = d.tables || []; renderTablesGrid(); } }).catch(()=>{});
    }

    function renderTablesGrid() {
      const container = document.getElementById('tables-grid');
      container.replaceChildren();
      const totalPages = Math.max(1, Math.ceil(allTables.length / tablesPerPage));
      const pageTables = allTables.slice((currentTablePage - 1) * tablesPerPage, currentTablePage * tablesPerPage);

      pageTables.forEach(t => {
        const isSel = selectedTable?.table_id === t.table_id, hasUnpaid = t.active_order_count > 0;
        const btn = document.createElement('button');
        btn.className = `rounded-2xl border-2 p-2.5 flex flex-col items-center justify-center transition cursor-pointer ${isSel ? 'border-[#eab308] bg-[#fef08a] shadow-[0_2px_0_#ca8a04]' : 'border-[#dfd5c6] bg-white shadow-[0_1.5px_0_#dfd5c6] hover:bg-[#fef9c3] hover:border-[#facc15]'}`;
        btn.onclick = () => selectAndLoadTable(t.table_id);

        const spanNumber = document.createElement('span');
        spanNumber.className = `text-xs font-black ${isSel ? 'text-[#a16207]' : 'text-[#4a3728]'}`;
        spanNumber.textContent = t.table_number;

        const spanStatus = document.createElement('span');
        spanStatus.className = `text-[11px] font-extrabold mt-0.5 ${hasUnpaid ? 'text-[#ea580c]' : 'text-[#a89a8c]'}`;
        spanStatus.textContent = hasUnpaid ? `${t.unpaid_total} ฿` : 'ว่าง';

        btn.append(spanNumber, spanStatus);
        container.appendChild(btn);
      });

      document.getElementById('table-prev-btn').disabled = currentTablePage <= 1;
      document.getElementById('table-next-btn').disabled = currentTablePage >= totalPages;
      document.getElementById('table-page-indicator').textContent = `${currentTablePage} / ${totalPages}`;
    }

    function changePage(d) { currentTablePage += d; renderTablesGrid(); }

    function selectAndLoadTable(id) {
      selectedTable = allTables.find(t => t.table_id === id); renderTablesGrid(); syncToCustomerDisplay(paymentMethod);
      fetch(`/cashier/api/table-bill?table_id=${id}`).then(r=>r.json()).then(d => { if(d.success) { currentBill = d; renderBill(); } else alert(d.message); });
    }

    function renderBill() {
      const tbody = document.getElementById('bill-tbody');
      tbody.replaceChildren();
      const items = currentBill?.items || [];
      const hasBill = currentBill && items.length > 0;
      const total = hasBill ? currentBill.grand_total : 0;

      document.getElementById('table-title').textContent = selectedTable ? `รายการอาหาร ${selectedTable.table_number} ${hasBill ? `(${currentBill.card_id||'-'})` : '(ไม่มีรายการค้าง)'}` : 'รายการอาหาร (เลือกโต๊ะ)';
      document.getElementById('col2-grand-total').textContent = total;
      document.getElementById('col3-grand-total').textContent = `${total} ฿`;
      document.getElementById('transfer-qr-amount').textContent = total;
      document.getElementById('confirm-payment-btn').disabled = !hasBill;

      for (let i = 0; i < Math.max(8, items.length); i++) {
        const item = items[i], tr = document.createElement('tr');
        tr.className = "hover:bg-[#fffbeb] transition";
        if (items.length <= 8) tr.style.height = '12.5%';
        if (item) {
          const custom = [item.options_text, item.toppings_text].filter(Boolean).join(' / ') || '-';

          const tdIndex = document.createElement('td');
          tdIndex.className = 'font-extrabold border-r border-b border-[#e8decb]';
          tdIndex.textContent = i + 1;

          const tdName = document.createElement('td');
          tdName.className = 'text-left pl-3.5 font-extrabold text-[#2d221b] border-r border-b border-[#e8decb]';
          tdName.textContent = item.menu_name;

          const tdCustom = document.createElement('td');
          tdCustom.className = 'text-left pl-3.5 text-[11px] text-[#716155] border-r border-b border-[#e8decb]';
          tdCustom.textContent = custom;

          const tdQty = document.createElement('td');
          tdQty.className = 'font-black text-[#2d221b] border-r border-b border-[#e8decb]';
          tdQty.textContent = item.quantity;

          const tdTotal = document.createElement('td');
          tdTotal.className = 'font-black text-[#ea580c] border-b border-[#e8decb]';
          tdTotal.textContent = `${item.item_total} ฿`;

          tr.append(tdIndex, tdName, tdCustom, tdQty, tdTotal);
        } else {
          for(let j=0; j<5; j++) {
            const td = document.createElement('td');
            td.className = "border-b border-[#e8decb]" + (j < 4 ? " border-r" : "");
            tr.appendChild(td);
          }
        }
        tbody.appendChild(tr);
      }
      rawAmountPaid = ''; updateCashDisplay();
    }

    function setPaymentMethod(m) {
      paymentMethod = m;
      const isTr = m === 'TRANSFER';
      document.getElementById('btn-transfer').className = `flex-1 h-10 rounded-xl font-black text-xs flex items-center justify-center gap-1.5 shadow-[0_2px_0_#4a3728] transition cursor-pointer border-2 ${isTr ? 'border-[#0369a1] bg-[#0284c7] text-white' : 'border-[#4a3728] bg-[#f0f9ff] text-[#0284c7]'}`;
      document.getElementById('btn-cash').className = `flex-1 h-10 rounded-xl font-black text-xs flex items-center justify-center gap-1.5 shadow-[0_2px_0_#4a3728] transition cursor-pointer border-2 ${isTr ? 'border-[#4a3728] bg-[#ecfdf5] text-[#047857]' : 'border-[#047857] bg-[#10b981] text-white'}`;
      document.getElementById('transfer-mode').classList.toggle('hidden', !isTr);
      document.getElementById('cash-mode').classList.toggle('hidden', isTr);
      syncToCustomerDisplay(m);
    }

    function pressKey(k) {
      if (k === 'CLEAR') rawAmountPaid = '';
      else if (k === 'BACK') rawAmountPaid = rawAmountPaid.slice(0, -1);
      else if (k === '.') { if (!rawAmountPaid.includes('.')) rawAmountPaid = (rawAmountPaid || '0') + '.'; }
      else if (rawAmountPaid.length < 8) rawAmountPaid += k;
      updateCashDisplay();
    }

    function setExactAmount() { if(currentBill) { rawAmountPaid = String(currentBill.grand_total); updateCashDisplay(); } }
    function addQuickCash(n) { rawAmountPaid = String((parseFloat(rawAmountPaid)||0) + n); updateCashDisplay(); }

    function updateCashDisplay() {
      const paid = parseFloat(rawAmountPaid) || 0, total = currentBill ? currentBill.grand_total : 0, change = paid - total;
      document.getElementById('display-amount-paid').textContent = rawAmountPaid ? `${rawAmountPaid} ฿` : '0 ฿';
      const el = document.getElementById('display-change');
      el.textContent = paid === 0 || change < 0 ? '0 ฿' : `${change.toFixed(2).replace(/\.00$/, '')} ฿`;
      el.className = `text-[15px] font-black ${paid === 0 || change < 0 ? 'text-[#9ca3af]' : 'text-[#10b981]'}`;
    }

    function confirmPayment() {
      if (!currentBill?.items?.length) return alert('กรุณาเลือกโต๊ะที่มีรายการอาหาร');
      const total = currentBill.grand_total, paid = paymentMethod === 'CASH' ? (parseFloat(rawAmountPaid) || 0) : total;
      if (paymentMethod === 'CASH' && paid < total) return alert('⚠️ จำนวนเงินที่รับมาไม่เพียงพอ');

      fetch('/cashier/api/checkout', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ table_id: currentBill.table_id, total_amount: total, payment_method: paymentMethod, amount_paid: paid, change_amount: Math.max(0, paid - total) })
      }).then(r=>r.json()).then(d => { if(d.success && d.payment) showReceiptModal(d.payment); else alert('ชำระเงินไม่สำเร็จ: ' + d.message); }).catch(()=>alert('เกิดข้อผิดพลาดในการเชื่อมต่อ'));
    }

    function showReceiptModal(p) {
      document.getElementById('receipt-table').textContent = p.table_number || selectedTable?.table_number || 'T05';
      document.getElementById('receipt-card').textContent = p.card_id || currentBill?.card_id || 'CARD-05';
      document.getElementById('receipt-no').textContent = `#REC-${String(p.payment_id||7).padStart(4, '0')}`;
      const d = p.payment_time ? new Date(p.payment_time) : new Date();
      document.getElementById('receipt-date').textContent = `${d.getDate()}/${d.getMonth()+1}/${d.getFullYear()+543} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}:${String(d.getSeconds()).padStart(2,'0')}`;

      const list = document.getElementById('receipt-items-list');
      list.replaceChildren();
      (p.items || currentBill?.items || []).forEach(it => {
        const custom = [it.options_text, it.toppings_text].filter(Boolean).join(' / ');
        const rowDiv = document.createElement('div');
        rowDiv.className = 'flex justify-between items-start';

        const infoDiv = document.createElement('div');
        infoDiv.className = 'pr-2';

        const nameDiv = document.createElement('div');
        nameDiv.className = 'font-black text-[13px] text-[#4a3728]';
        nameDiv.textContent = `${it.menu_name} `;

        const qtySpan = document.createElement('span');
        qtySpan.className = 'text-[#716155] text-xs font-extrabold';
        qtySpan.textContent = `x${it.quantity}`;
        nameDiv.appendChild(qtySpan);
        infoDiv.appendChild(nameDiv);

        if (custom) {
          const customDiv = document.createElement('div');
          customDiv.className = 'text-[10px] text-[#8c7a6b] font-bold mt-px';
          customDiv.textContent = `- ${custom}`;
          infoDiv.appendChild(customDiv);
        }

        const priceDiv = document.createElement('div');
        priceDiv.className = 'font-black text-[13px] text-[#4a3728] whitespace-nowrap';
        priceDiv.textContent = `${it.item_total} ฿`;

        rowDiv.append(infoDiv, priceDiv);
        list.appendChild(rowDiv);
      });
      document.getElementById('receipt-total').textContent = p.total_amount;
      document.getElementById('receipt-method').textContent = p.payment_method;
      document.getElementById('receipt-paid').textContent = p.amount_paid;
      document.getElementById('receipt-change').textContent = p.change_amount;
      toggleModal('receipt-modal', true);
    }

    function closeReceiptAndReset() {
      toggleModal('receipt-modal', false);
      selectedTable = null; currentBill = null; rawAmountPaid = ''; paymentMethod = 'CASH';
      syncToCustomerDisplay('CASH'); renderBill(); loadTables();
    }

    function toggleModal(id, show) {
      const el = document.getElementById(id);
      if (show) el.classList.remove('hidden'), el.classList.add('flex');
      else el.classList.add('hidden'), el.classList.remove('flex');
      if(show && id==='scan-modal') document.getElementById('manual-card-input').focus();
    }

    function selectCardCode(code) {
      if (!code) return; toggleModal('scan-modal', false);
      fetch(`/cashier/api/table-bill?card_id=${encodeURIComponent(code.trim().toUpperCase())}`).then(r=>r.json()).then(d => {
        if(d.success) {
          currentBill = d; selectedTable = allTables.find(t => t.table_id === d.table_id);
          const idx = allTables.findIndex(t => t.table_id === d.table_id);
          if (idx >= 0) currentTablePage = Math.floor(idx / tablesPerPage) + 1;
          renderTablesGrid(); renderBill();
        } else alert(d.message || 'ไม่พบการ์ดหรือโต๊ะนี้');
      });
    }

    loadTables(); renderBill(); setInterval(loadTables, 5000);
  </script>
</body>
</html>