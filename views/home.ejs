<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Main Control - Koumiya Ramen</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900 font-sans min-h-screen flex flex-col justify-between p-4 md:p-6">

  <div class="max-w-6xl mx-auto w-full space-y-6">
    
    <!-- Hero Header: Main Control -->
    <div class="text-center space-y-3 pt-2">
      <div class="inline-flex items-center gap-2 bg-red-600 text-white font-black px-4 py-1.5 rounded-full text-xs tracking-widest uppercase shadow">
        MAIN CONTROL PANEL EIEI
      </div>
      <p class="text-gray-600 text-sm md:text-base max-w-2xl mx-auto font-medium">
        Koumiya Ramen <code class="bg-gray-200 px-2 py-0.5 rounded font-mono text-red-600 font-bold">/mainControl</code>
      </p>
    </div>
    <!-- QR Scan & Table Auto-Assignment Simulator Box -->
    <div class="bg-gradient-to-r from-red-50 to-orange-50 border-4 border-black p-5 rounded-2xl shadow-lg flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-20 h-20 bg-white border-2 border-black rounded-xl p-2 flex items-center justify-center shadow-sm shrink-0">
          <img src="/images/mock-qr.svg" alt="QR Code" class="w-full h-full object-contain">
        </div>
        <div class="space-y-1">
          <div class="inline-block bg-black text-white text-[11px] font-bold px-2.5 py-0.5 rounded-full">
            การทำงานเมื่อลูกค้าสแกน QR
          </div>
          <h2 class="text-lg md:text-xl font-black text-gray-900">
            ระบบแจกลำดับโต๊ะอัตโนมัติ
          </h2>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row gap-2 shrink-0 w-full md:w-auto">
        <a href="/scan?new=1" target="_blank"
           class="bg-red-600 hover:bg-red-700 text-white font-black px-5 py-3 rounded-xl text-center text-xs md:text-sm shadow transition flex items-center justify-center gap-2">
          จำลองลูกค้าสแกนได้โต๊ะใหม่
        </a>
        <button onclick="clearMyTableCookie()" 
                class="bg-white hover:bg-gray-100 text-gray-800 border-2 border-black font-bold px-4 py-3 rounded-xl text-center text-xs transition">
          ล้าง Cookie
        </button>
      </div>
    </div>

    <!-- 3 Main Role Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- CARD 1: Customer Tablet -->
      <div class="bg-white border-4 border-black p-6 rounded-2xl shadow-xl flex flex-col justify-between hover:-translate-y-1 transition duration-200">
        <div class="space-y-4">
          <div class="w-14 h-14 bg-red-100 border-2 border-red-500 rounded-xl flex items-center justify-center text-3xl">
            🍜
          </div>
          <div>
            <h2 class="text-2xl font-black text-gray-900">1. ฝั่งลูกค้า (Customer)</h2>
          </div>
          <div class="space-y-2 pt-2">
            <label for="quick-table-select" class="text-xs font-bold text-gray-600 block">เลือกโต๊ะที่ต้องการเปิดดู:</label>
            <div class="flex gap-2">
              <select id="quick-table-select" class="flex-1 border-2 border-black rounded-xl p-2.5 font-bold text-sm bg-gray-50">
                <% for(let i = 1; i <= 20; i++) { 
                     const tNum = `T${String(i).padStart(2, '0')}`;
                %>
                  <option value="<%= tNum %>" <%= tNum === 'T05' ? 'selected' : '' %>>
                    โต๊ะ <%= tNum %> (CARD-<%= String(i).padStart(2, '0') %>)
                  </option>
                <% } %>
              </select>
              <button onclick="goToCustomerTable()" 
                      class="bg-red-600 hover:bg-red-700 text-white font-bold px-4 py-2.5 rounded-xl text-sm transition">
                ไป
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- CARD 2: Chef KDS -->
      <div class="bg-white border-4 border-black p-6 rounded-2xl shadow-xl flex flex-col justify-between hover:-translate-y-1 transition duration-200">
        <div class="space-y-4">
          <div class="w-14 h-14 bg-yellow-100 border-2 border-yellow-500 rounded-xl flex items-center justify-center text-3xl">
            👨‍🍳
          </div>
          <div>
            <h2 class="text-2xl font-black text-gray-900">2. ฝั่งครัว (Chef KDS)</h2>
          </div>
        </div>
        <div class="pt-6 border-t border-gray-200 mt-4">
          <a href="/chef" 
             class="block w-full bg-yellow-500 hover:bg-yellow-600 text-black font-black py-3 rounded-xl text-center text-sm shadow transition">
            เปิดหน้าจอครัว (/chef)
          </a>
        </div>
      </div>

      <!-- CARD 3: Cashier POS -->
      <div class="bg-white border-4 border-black p-6 rounded-2xl shadow-xl flex flex-col justify-between hover:-translate-y-1 transition duration-200">
        <div class="space-y-4">
          <div class="w-14 h-14 bg-blue-100 border-2 border-blue-500 rounded-xl flex items-center justify-center text-3xl">
            💳
          </div>
          <div>
            <h2 class="text-2xl font-black text-gray-900">3. ฝั่งแคชเชียร์ (Cashier)</h2>
          </div>
        </div>
        <div class="pt-6 border-t border-gray-200 mt-4 space-y-2">
          <a href="/cashier" 
             class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl text-center text-sm shadow transition">
            เปิดระบบแคชเชียร์ (/cashier)
          </a>
          <a href="/cashier/customer-display" target="_blank"
             class="block w-full bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold py-2.5 rounded-xl text-center text-xs border-2 border-black transition">
            🖥️ จอแคชเชียร์ฝั่งลูกค้า (Customer Display)
          </a>
        </div>
      </div>
    </div>
  </div>
  <script>
    function goToCustomerTable() {
      const tableVal = document.getElementById('quick-table-select').value;
      window.location.href = `/customer/${tableVal}`;
    }

    function clearMyTableCookie() {
      document.cookie = "customer_table=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;";
      alert('ล้าง Cookie โต๊ะของเครื่องนี้เรียบร้อยแล้ว หากสแกนหน้าแรกใหม่จะได้รับแจกโต๊ะถัดไปทันที');
    }

    function resetAllDemoOrders() {
      if (!confirm('ต้องการล้างข้อมูลออเดอร์ทั้งหมด และรีเซ็ตการแจกโต๊ะใหม่หรือไม่?')) return;
      fetch('/api/reset-demo-orders', { method: 'POST' })
        .then(res => res.json())
        .then(data => {
          alert('ล้างข้อมูลเรียบร้อยแล้ว ทุกโต๊ะว่าง และลำดับการสแกนแจกโต๊ะเริ่มนับจากโต๊ะ 1 ใหม่');
          location.reload();
        })
        .catch(err => alert('เกิดข้อผิดพลาดในการเชื่อมต่อ'));
    }
  </script>
</body>
</html>
