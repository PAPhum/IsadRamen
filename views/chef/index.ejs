<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ห้องครัว (Chef KDS) | IsadRamen</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="[background:radial-gradient(circle_at_center,_#fff7ed_0%,_#fef3c7_45%,_#f5f5f4_100%)] h-screen w-screen p-2 md:p-4 font-sans select-none overflow-hidden flex flex-col">

  <!-- Chef Tablet / Monitor Container -->
  <div class="w-full h-full bg-white border-2 border-[#4a3728] shadow-[0_12px_28px_rgba(74,55,40,0.10)] ring-4 ring-amber-200/40 p-4 md:p-6 relative flex flex-col justify-between rounded-sm overflow-hidden flex-1">
    
    <!-- ======================================================== -->
    <!-- VIEW 1: คิวรายการอาหาร (Queue View) -->
    <!-- ======================================================== -->
    <div id="view-queue" class="flex-1 flex flex-col justify-between h-full min-h-0">
      <div class="flex-1 flex flex-col overflow-hidden min-h-0">
        <div class="mb-4 flex items-center justify-center gap-3">
          <!-- กล่องไอคอน -->
          <div class="bg-amber-100 border-2 border-[#4a3728] shadow-[0_2px_0_#4a3728] p-1.5 rounded-lg text-xl flex items-center justify-center">
            🍜
          </div>
          <h2 class="text-center font-black text-2xl tracking-wide text-[#4a3728]">คิวรายการอาหาร</h2>
        </div>

        <!-- ตารางคิวอาหาร -->
        <div class="flex-1 border border-[#4a3728] overflow-hidden flex flex-col min-h-0 rounded-sm">
          <table class="w-full h-full border-collapse text-xs md:text-sm text-center table-fixed">
            <thead>
              <tr class="border-b-2 border-[#4a3728] bg-[#fbe8b3]/90 font-bold h-10 text-[#4a3728]">
                <th class="border-r border-[#edd69a] p-2 w-16">ID</th>
                <th class="border-r border-[#edd69a] p-2 w-20">โต๊ะ</th>
                <th class="border-r border-[#edd69a] p-2 text-left pl-4">รายการอาหาร</th>
                <th class="border-r border-[#edd69a] p-2 w-20">จำนวน</th>
                <th class="p-2 w-28">สถานะ</th>
              </tr>
            </thead>
            <tbody id="queue-tbody" class="h-full">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- แถบด้านล่าง: ปุ่มประวัติรายการ -->
      <div class="flex justify-start items-center border-t-2 border-[#4a3728]/30 pt-4 mt-4">
        <button onclick="switchChefView('history')" 
                class="bg-emerald-50/80 border-2 border-emerald-300 text-emerald-800 hover:bg-emerald-100 font-bold px-8 py-2.5 rounded-xl transition text-sm cursor-pointer shadow-sm">
          ประวัติรายการ
        </button>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- VIEW 2: ประวัติรายการอาหาร (Finished History View) -->
    <!-- ======================================================== -->
    <div id="view-history" class="hidden flex-1 flex flex-col justify-between h-full min-h-0">
      <div class="flex-1 flex flex-col overflow-hidden min-h-0">
        <div class="mb-4 flex items-center justify-center gap-3">
          <div class="bg-amber-100 border-2 border-[#4a3728] shadow-[0_2px_0_#4a3728] p-1.5 rounded-lg text-xl flex items-center justify-center">
            📋
          </div>
          <h2 class="text-center font-black text-2xl tracking-wide text-[#4a3728]">ประวัติรายการอาหาร</h2>
        </div>

        <!-- ตารางประวัติที่ทำเสร็จแล้ว -->
        <div class="flex-1 border border-[#4a3728] overflow-hidden flex flex-col min-h-0 rounded-sm">
          <table class="w-full h-full border-collapse text-xs md:text-sm text-center table-fixed">
            <thead>
              <tr class="border-b-2 border-[#4a3728] bg-[#fbe8b3]/90 font-bold h-10 text-[#4a3728]">
                <th class="border-r border-[#edd69a] p-2 w-16">ID</th>
                <th class="border-r border-[#edd69a] p-2 w-20">โต๊ะ</th>
                <th class="border-r border-[#edd69a] p-2 text-left pl-4">รายการอาหาร</th>
                <th class="border-r border-[#edd69a] p-2 w-20">จำนวน</th>
                <th class="p-2 w-28">สถานะ</th>
              </tr>
            </thead>
            <tbody id="history-tbody" class="h-full">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- แถบด้านล่าง: ปุ่มย้อนกลับ -->
      <div class="flex justify-start items-center border-t-2 border-[#4a3728]/30 pt-4 mt-4">
        <button onclick="switchChefView('queue')" 
                class="bg-stone-50 border-2 border-[#4a3728] text-[#4a3728] shadow-[0_2px_0_#4a3728] hover:bg-stone-100 font-bold px-8 py-2.5 rounded-xl transition text-sm cursor-pointer">
          ย้อนกลับ
        </button>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- DETAIL MODAL: เมื่อกดที่รายการอาหาร -->
    <!-- ======================================================== -->
    <div id="chef-detail-modal" class="hidden absolute inset-0 bg-white border-4 border-[#4a3728] p-8 flex flex-col justify-between z-40">
      <div>
        <h2 class="text-center font-black text-3xl mb-6 text-[#4a3728]" id="detail-modal-title">
          ID: 005
        </h2>

        <!-- ตารางสรุปย่อ -->
        <table class="w-full border-collapse border border-[#4a3728] text-sm text-center mb-6">
          <thead>
            <tr class="border-b-2 border-[#4a3728] bg-[#fbe8b3]/90 font-bold text-[#4a3728]">
              <th class="border-r border-[#edd69a] p-2 w-20">ID</th>
              <th class="border-r border-[#edd69a] p-2 w-24">โต๊ะ</th>
              <th class="border-r border-[#edd69a] p-2 text-left pl-4">รายการอาหาร</th>
              <th class="border-r border-[#edd69a] p-2 w-20">จำนวน</th>
              <th class="p-2 w-28">สถานะ</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-stone-200">
              <td class="border-r border-stone-200 p-3 font-bold text-stone-600 bg-stone-50/60" id="detail-id">-</td>
              <td class="border-r border-stone-200 p-3 font-black text-orange-600 bg-orange-50/40 text-base" id="detail-table">-</td>
              <td class="border-r border-stone-200 p-3 text-left pl-4 font-bold text-[#4a3728]" id="detail-menu">-</td>
              <td class="border-r border-stone-200 p-3 font-bold text-[#4a3728]" id="detail-qty">-</td>
              <td class="p-3 font-bold text-[#4a3728]" id="detail-status">-</td>
            </tr>
          </tbody>
        </table>

        <!-- รายละเอียดการปรับแต่งและท็อปปิ้ง -->
        <div class="bg-amber-50/50 border-2 border-dashed border-amber-300 p-4 rounded-lg space-y-2">
          <p class="font-bold text-[#4a3728] text-sm">รายละเอียดการสั่ง:</p>
          <div id="detail-customization" class="text-sm text-stone-600 pl-4 space-y-1">
            <!-- Rendered by JS -->
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div>
        <!-- ปุ่มหลักสำหรับ Queue / Prepare / Finish -->
        <div id="detail-actions" class="flex justify-center items-center gap-6 mb-4">
          <!-- Dynamic Buttons will be inserted here -->
        </div>

        <!-- ปุ่มย้อนกลับ มุมล่างซ้าย -->
        <div class="flex justify-start border-t border-[#4a3728]/30 pt-4">
          <button onclick="closeDetailModal()" 
                  class="bg-stone-50 border-2 border-[#4a3728] text-[#4a3728] shadow-[0_2px_0_#4a3728] hover:bg-stone-100 font-bold px-8 py-2.5 rounded-xl transition text-sm">
            ย้อนกลับ
          </button>
        </div>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- FOOD SLIP MODAL: ใบรายการอาหารแบบจำลอง -->
    <!-- ======================================================== -->
    <div id="food-slip-modal" class="hidden absolute inset-0 bg-black/60 flex items-center justify-center z-50 p-4">
      <div class="bg-white border-2 border-amber-200/90 ring-4 ring-amber-100/70 w-[380px] p-6 rounded-lg shadow-2xl flex flex-col justify-between font-mono">
        <div>
          <div class="text-center border-b-2 border-dashed border-[#4a3728] pb-3 mb-3">
            <h3 class="font-black text-xl text-[#4a3728] tracking-widest">FOOD SLIP</h3>
            <p class="text-xs text-[#4a3728]/70 font-sans mt-0.5">ใบรายการอาหารสำหรับส่งโต๊ะ</p>
          </div>

          <div class="bg-amber-50/40 border border-amber-200/70 p-2.5 rounded-md mb-3 space-y-1 text-sm border-dashed">
            <div class="flex justify-between font-bold text-base items-center">
              <span class="text-[#4a3728]">TABLE:</span>
              <span id="slip-table" class="bg-white border border-orange-200 text-orange-600 font-black px-2 py-0.5 rounded">T05</span>
            </div>
            <div class="flex justify-between text-xs text-[#4a3728]/80">
              <span>ITEM ID:</span>
              <span id="slip-id">#005</span>
            </div>
            <div class="flex justify-between text-xs text-[#4a3728]/80">
              <span>TIME:</span>
              <span id="slip-time">19:30</span>
            </div>
          </div>

          <div class="border-b-2 border-dashed border-[#4a3728] pb-3 mb-4 space-y-2">
            <div class="flex justify-between font-black text-lg text-[#4a3728]">
              <span id="slip-menu">ทงคตสึราเมง</span>
              <span id="slip-qty">x1</span>
            </div>
            <div id="slip-details" class="text-xs text-[#4a3728]/80 pl-2 space-y-1 font-sans">
              <!-- Options & Toppings -->
            </div>
          </div>
        </div>

        <div class="flex gap-3 pt-2">
          <button onclick="printFoodSlip()" 
                  class="flex-1 bg-amber-500 hover:bg-amber-600 border-2 border-[#4a3728] text-white shadow-[0_3px_0_#4a3728] font-bold py-2.5 rounded-lg text-sm transition">
            พิมพ์ใบจำลอง
          </button>
          <button onclick="closeFoodSlip()" 
                  class="flex-1 bg-white border-2 border-stone-300 text-stone-700 shadow-[0_3px_0_#d6d3d1] hover:bg-stone-50 font-bold py-2.5 rounded-lg text-sm transition">
            ปิด
          </button>
        </div>
      </div>
    </div>

  </div>

  <script>
    let queueOrders = [];
    let historyOrders = [];
    let currentSelectedOrder = null;
    let activeChefView = 'queue';

    function switchChefView(view) {
      activeChefView = view;
      if (view === 'queue') {
        document.getElementById('view-queue').classList.remove('hidden');
        document.getElementById('view-history').classList.add('hidden');
      } else {
        document.getElementById('view-queue').classList.add('hidden');
        document.getElementById('view-history').classList.remove('hidden');
      }
      closeDetailModal();
    }

    function fetchChefOrders() {
      fetch('/chef/api/orders')
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            queueOrders = data.queueOrders || [];
            historyOrders = data.historyOrders || [];
            renderQueueTable();
            renderHistoryTable();

            if (currentSelectedOrder) {
              const updated = [...queueOrders, ...historyOrders].find(o => o.order_item_id === currentSelectedOrder.order_item_id);
              if (updated) {
                currentSelectedOrder = updated;
                updateDetailModalContent(updated);
              }
            }
          }
        })
        .catch(err => console.error('Chef fetch error:', err));
    }

    function padId(id) {
      return String(id).padStart(3, '0');
    }

    // Render ตารางคิวรายการอาหาร (Queue View)
    function renderQueueTable() {
      const tbody = document.getElementById('queue-tbody');
      tbody.replaceChildren();

      const totalSlots = Math.max(8, queueOrders.length);

      for (let i = 0; i < totalSlots; i++) {
        const item = queueOrders[i];
        const tr = document.createElement('tr');
        tr.className = 'border-b border-stone-200 hover:bg-amber-100/70 transition';
        if (totalSlots === 8) {
          tr.style.height = '12.5%';
        }

        if (item) {
          tr.classList.add('cursor-pointer');
          tr.onclick = () => openDetailModal(item.order_item_id);

          const tdId = document.createElement('td');
          tdId.className = 'border-r border-stone-200 font-bold text-stone-600 bg-stone-50/60 align-middle';
          tdId.textContent = padId(item.order_item_id);

          const tdTable = document.createElement('td');
          tdTable.className = 'border-r border-stone-200 font-black text-orange-600 bg-orange-50/40 text-base align-middle';
          tdTable.textContent = item.table_number;

          const tdName = document.createElement('td');
          tdName.className = 'border-r border-stone-200 text-left pl-4 align-middle';
          const nameDiv = document.createElement('div');
          nameDiv.className = 'font-bold text-[#4a3728]';
          nameDiv.textContent = item.menu_name;
          tdName.appendChild(nameDiv);

          const summaryDetail = [item.options_text, item.toppings_text].filter(Boolean).join(' | ');
          if (summaryDetail) {
            const detailDiv = document.createElement('div');
            detailDiv.className = 'text-[11px] text-stone-500';
            detailDiv.textContent = summaryDetail;
            tdName.appendChild(detailDiv);
          }

          const tdQty = document.createElement('td');
          tdQty.className = 'border-r border-stone-200 font-bold text-[#4a3728] text-base align-middle';
          tdQty.textContent = item.quantity;

          const tdStatus = document.createElement('td');
          tdStatus.className = 'p-2 font-bold text-xs md:text-sm text-[#4a3728] align-middle';
          const isPreparing = item.status === 'prepare';
          tdStatus.textContent = isPreparing ? 'กำลังทำ' : 'อยู่ในคิว';

          tr.append(tdId, tdTable, tdName, tdQty, tdStatus);
        } else {
          for (let j = 0; j < 5; j++) {
            const td = document.createElement('td');
            if (j < 4) td.className = 'border-r border-stone-200 align-middle';
            tr.appendChild(td);
          }
        }
        tbody.appendChild(tr);
      }
    }

    // Render ตารางประวัติรายการ (History View)
    function renderHistoryTable() {
      const tbody = document.getElementById('history-tbody');
      tbody.replaceChildren();

      const totalSlots = Math.max(8, historyOrders.length);

      for (let i = 0; i < totalSlots; i++) {
        const item = historyOrders[i];
        const tr = document.createElement('tr');
        tr.className = 'border-b border-stone-200 hover:bg-amber-100/70 transition';
        if (totalSlots === 8) {
          tr.style.height = '12.5%';
        }

        if (item) {
          tr.classList.add('cursor-pointer');
          tr.onclick = () => openDetailModal(item.order_item_id);

          const tdId = document.createElement('td');
          tdId.className = 'border-r border-stone-200 font-bold text-stone-600 bg-stone-50/60 align-middle';
          tdId.textContent = padId(item.order_item_id);

          const tdTable = document.createElement('td');
          tdTable.className = 'border-r border-stone-200 font-black text-orange-600 bg-orange-50/40 text-base align-middle';
          tdTable.textContent = item.table_number;

          const tdName = document.createElement('td');
          tdName.className = 'border-r border-stone-200 text-left pl-4 align-middle';
          const nameDiv = document.createElement('div');
          nameDiv.className = 'font-bold text-[#4a3728]';
          nameDiv.textContent = item.menu_name;
          tdName.appendChild(nameDiv);

          const summaryDetail = [item.options_text, item.toppings_text].filter(Boolean).join(' | ');
          if (summaryDetail) {
            const detailDiv = document.createElement('div');
            detailDiv.className = 'text-[11px] text-stone-500';
            detailDiv.textContent = summaryDetail;
            tdName.appendChild(detailDiv);
          }

          const tdQty = document.createElement('td');
          tdQty.className = 'border-r border-stone-200 font-bold text-[#4a3728] text-base align-middle';
          tdQty.textContent = item.quantity;

          const tdStatus = document.createElement('td');
          tdStatus.className = 'p-2 font-bold text-xs md:text-sm text-[#4a3728] align-middle';
          tdStatus.textContent = 'เสร็จสิ้น';

          tr.append(tdId, tdTable, tdName, tdQty, tdStatus);
        } else {
          for (let j = 0; j < 5; j++) {
            const td = document.createElement('td');
            if (j < 4) td.className = 'border-r border-stone-200 align-middle';
            tr.appendChild(td);
          }
        }
        tbody.appendChild(tr);
      }
    }

    function openDetailModal(orderItemId) {
      const all = [...queueOrders, ...historyOrders];
      const item = all.find(o => o.order_item_id === orderItemId);
      if (!item) return;

      currentSelectedOrder = item;
      updateDetailModalContent(item);
      document.getElementById('chef-detail-modal').classList.remove('hidden');
    }

    function closeDetailModal() {
      document.getElementById('chef-detail-modal').classList.add('hidden');
      currentSelectedOrder = null;
    }

    function updateDetailModalContent(item) {
      document.getElementById('detail-modal-title').textContent = `ID: ${padId(item.order_item_id)}`;
      document.getElementById('detail-id').textContent = padId(item.order_item_id);
      document.getElementById('detail-table').textContent = item.table_number;
      document.getElementById('detail-menu').textContent = item.menu_name;
      document.getElementById('detail-qty').textContent = item.quantity;

      const statusMap = {
        'queue': 'อยู่ในคิว',
        'prepare': 'กำลังทำ',
        'finish': 'เสร็จสิ้น'
      };
      document.getElementById('detail-status').textContent = statusMap[item.status] || item.status;

      const customDiv = document.getElementById('detail-customization');
      customDiv.replaceChildren();
      if (item.options_text) {
        const optDiv = document.createElement('div');
        const strong = document.createElement('strong');
        strong.textContent = 'ตัวเลือก:';
        optDiv.append(strong, document.createTextNode(' ' + item.options_text));
        customDiv.appendChild(optDiv);
      }
      if (item.toppings_text) {
        const topDiv = document.createElement('div');
        const strong = document.createElement('strong');
        strong.textContent = 'ท็อปปิ้ง:';
        topDiv.append(strong, document.createTextNode(' ' + item.toppings_text));
        customDiv.appendChild(topDiv);
      }
      if (!item.options_text && !item.toppings_text) {
        const noCustomSpan = document.createElement('span');
        noCustomSpan.className = 'text-stone-400';
        noCustomSpan.textContent = 'ไม่มีการปรับแต่งเพิ่มเติม';
        customDiv.appendChild(noCustomSpan);
      }

      const actionsDiv = document.getElementById('detail-actions');
      actionsDiv.replaceChildren();

      if (item.status === 'queue') {
        // ปุ่มรับคำสั่งซื้อ (สถานะ queue)
        const btn = document.createElement('button');
        btn.onclick = () => updateOrderStatus(item.order_item_id, 'prepare');
        btn.className = 'bg-orange-500 hover:bg-orange-600 border-2 border-[#4a3728] text-white shadow-[0_3px_0_#4a3728] font-bold px-12 py-4 rounded-2xl text-xl transition active:scale-95';
        btn.textContent = 'รับคำสั่งซื้อ';
        actionsDiv.appendChild(btn);
      } else if (item.status === 'prepare') {
        // ปุ่มย้ายกลับไปในคิว (สถานะ prepare)
        const btnBack = document.createElement('button');
        btnBack.onclick = () => updateOrderStatus(item.order_item_id, 'queue');
        btnBack.className = 'bg-sky-50 border-2 border-sky-400 text-sky-800 shadow-[0_2px_0_#38bdf8] hover:bg-sky-100 font-bold px-8 py-3 rounded-2xl text-base transition active:scale-95';
        btnBack.textContent = 'อยู่ในคิว (กลับ)';

        const btnFinish = document.createElement('button');
        btnFinish.onclick = () => finishOrderAndShowSlip(item.order_item_id);
        btnFinish.className = 'bg-orange-500 hover:bg-orange-600 border-2 border-[#4a3728] shadow-[0_3px_0_#4a3728] text-white font-bold px-8 py-3.5 rounded-2xl text-lg transition active:scale-95 flex items-center justify-center gap-2';
        btnFinish.textContent = 'ทำเสร็จแล้ว';

        actionsDiv.append(btnBack, btnFinish);
      } else if (item.status === 'finish') {
        // ปุ่มนำกลับไปอยู่ในคิว และ ปุ่มพิมพ์ใบเมนูซ้ำ (สถานะ finish)
        const btnQueue = document.createElement('button');
        btnQueue.onclick = () => updateOrderStatus(item.order_item_id, 'queue');
        btnQueue.className = 'bg-sky-50 border-2 border-sky-300 text-sky-800 shadow-[0_2px_0_#bae6fd] hover:bg-sky-100 font-bold px-8 py-3 rounded-2xl text-sm transition active:scale-95';
        btnQueue.textContent = 'นำกลับไปอยู่ในคิว';

        const btnPrint = document.createElement('button');
        btnPrint.onclick = () => showFoodSlip(currentSelectedOrder);
        btnPrint.className = 'bg-amber-100 border-2 border-[#4a3728] text-[#4a3728] shadow-[0_2px_0_#4a3728] hover:bg-amber-200 font-bold px-8 py-3 rounded-2xl text-sm transition active:scale-95';
        btnPrint.textContent = 'พิมพ์ใบเมนู';

        actionsDiv.append(btnQueue, btnPrint);
      }
    }

    function updateOrderStatus(orderItemId, nextStatus) {
      fetch('/chef/api/update-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ order_item_id: orderItemId, next_status: nextStatus })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          fetchChefOrders();
          closeDetailModal();
        } else {
          alert('ไม่สามารถอัปเดตสถานะได้');
        }
      });
    }

    function finishOrderAndShowSlip(orderItemId) {
      fetch('/chef/api/update-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ order_item_id: orderItemId, next_status: 'finish' })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          const itemToSlip = currentSelectedOrder;
          closeDetailModal();
          fetchChefOrders();
          if (itemToSlip) {
            showFoodSlip(itemToSlip);
          }
        }
      });
    }

    function showFoodSlip(item) {
      document.getElementById('slip-table').textContent = item.table_number;
      document.getElementById('slip-id').textContent = '#' + padId(item.order_item_id);
      document.getElementById('slip-time').textContent = new Date(item.order_item_time).toLocaleTimeString('th-TH');
      document.getElementById('slip-menu').textContent = item.menu_name;
      document.getElementById('slip-qty').textContent = `x${item.quantity}`;

      const detailsContainer = document.getElementById('slip-details');
      detailsContainer.replaceChildren();

      if (item.options_text) {
        item.options_text.split(', ').forEach(opt => {
          const div = document.createElement('div');
          div.textContent = `• ${opt}`;
          detailsContainer.appendChild(div);
        });
      }
      if (item.toppings_text) {
        const header = document.createElement('div');
        header.className = 'font-bold pt-1';
        header.textContent = 'ท็อปปิ้ง:';
        detailsContainer.appendChild(header);

        item.toppings_text.split(', ').forEach(top => {
          const div = document.createElement('div');
          div.className = 'pl-2';
          div.textContent = `+ ${top}`;
          detailsContainer.appendChild(div);
        });
      }

      document.getElementById('food-slip-modal').classList.remove('hidden');
    }

    function closeFoodSlip() {
      document.getElementById('food-slip-modal').classList.add('hidden');
    }

    function printFoodSlip() {
      alert('[จำลองการพิมพ์] พิมพ์เรียบร้อย');
      closeFoodSlip();
    }

    fetchChefOrders();
    setInterval(fetchChefOrders, 3000);
  </script>
</body>
</html>