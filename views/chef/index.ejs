<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ห้องครัว (Chef KDS) | IsadRamen</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: { fontFamily: { sans: ['Prompt', 'sans-serif'] } }
      }
    }
  </script>
  <style>
    /* แถบเลื่อน Scrollbar สีนวลครีมเหลืองอ่อน มนสั้น สวยงาม */
    .custom-chef-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .custom-chef-scroll::-webkit-scrollbar-track {
      background: #fffdfa;
      border-radius: 8px;
    }
    .custom-chef-scroll::-webkit-scrollbar-thumb {
      background-color: #fde047;
      border: 1.5px solid #ca8a04;
      border-radius: 8px;
    }
    .custom-chef-scroll::-webkit-scrollbar-thumb:hover {
      background-color: #facc15;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-[#fff7ed] via-[#fef3c7] to-[#f5f5f4] min-h-screen flex items-center justify-center p-4 select-none text-[#4a3728] font-sans">

  <!-- Chef Tablet / Monitor Container -->
  <div class="w-full max-w-[1080px] h-[760px] bg-white border-2 border-[#4a3728] rounded-[28px] p-6 relative flex flex-col justify-between shadow-[0_10px_25px_-5px_rgba(74,55,40,0.06)] overflow-hidden">
    
    <!-- ======================================================== -->
    <!-- VIEW 1: คิวรายการอาหาร (Queue View) -->
    <!-- ======================================================== -->
    <div id="view-queue" class="flex-1 flex flex-col justify-between h-full min-h-0">
      <div class="flex-1 flex flex-col overflow-hidden min-h-0">
        
        <!-- Header -->
        <div class="flex justify-between items-center border-b-2 border-[#4a3728] pb-3 mb-4">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl border-2 border-[#4a3728] bg-[#fef3c7] flex items-center justify-center text-2xl shadow-[0_2px_0_#4a3728]">👨‍🍳</div>
            <h1 class="text-2xl font-black text-[#4a3728]">คิวรายการอาหาร (Kitchen Queue)</h1>
            <span class="bg-[#fef3c7] text-[#a46700] text-xs font-extrabold px-3 py-1 rounded-full border border-[#fde68a]">
              Chef KDS
            </span>
          </div>
        </div>

        <!-- ตารางคิวอาหาร (ตรึงเริ่มต้น 8 แถว และเลื่อนลงได้) -->
        <div class="flex-1 border-2 border-[#4a3728] rounded-2xl overflow-hidden flex flex-col min-h-0 bg-white shadow-[0_1.5px_0_#4a3728]">
          <div class="overflow-y-auto flex-1 h-full custom-chef-scroll">
            <table class="w-full border-collapse text-xs md:text-sm text-center table-fixed">
              <thead class="sticky top-0 z-10">
                <tr class="bg-[#fef3c7] text-[#4a3728] font-extrabold h-11 border-b-2 border-[#4a3728]">
                  <th class="border-r border-[#4a3728] w-16">ID</th>
                  <th class="border-r border-[#4a3728] w-20">โต๊ะ</th>
                  <th class="border-r border-[#4a3728] text-left pl-4">รายการอาหาร</th>
                  <th class="border-r border-[#4a3728] w-20">จำนวน</th>
                  <th class="w-28">สถานะ</th>
                </tr>
              </thead>
              <tbody id="queue-tbody">
                <!-- Rendered via JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- แถบด้านล่าง: ปุ่มประวัติรายการ -->
      <div class="flex justify-start items-center border-t border-[#dfd5c6] pt-4 mt-3">
        <button onclick="switchChefView('history')" 
                class="h-12 bg-white border-2 border-[#4a3728] hover:bg-[#fef9c3] font-black px-10 rounded-2xl text-[#4a3728] text-base shadow-[0_3px_0_#4a3728] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer flex items-center justify-center">
          ประวัติรายการอาหาร
        </button>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- VIEW 2: ประวัติรายการอาหาร (Finished History View) -->
    <!-- ======================================================== -->
    <div id="view-history" class="hidden flex-1 flex flex-col justify-between h-full min-h-0">
      <div class="flex-1 flex flex-col overflow-hidden min-h-0">
        
        <!-- Header -->
        <div class="flex justify-between items-center border-b-2 border-[#4a3728] pb-3 mb-4">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl border-2 border-[#4a3728] bg-[#fef3c7] flex items-center justify-center text-2xl shadow-[0_2px_0_#4a3728]">👨‍🍳</div>
            <h1 class="text-2xl font-black text-[#4a3728]">ประวัติรายการอาหารที่เสร็จแล้ว</h1>
            <span class="bg-[#e8f8f2] text-[#059669] text-xs font-extrabold px-3 py-1 rounded-full border border-[#a7e8ce]">
              Completed
            </span>
          </div>
        </div>

        <!-- ตารางประวัติ (ตรึงเริ่มต้น 8 แถว และเลื่อนลงได้) -->
        <div class="flex-1 border-2 border-[#4a3728] rounded-2xl overflow-hidden flex flex-col min-h-0 bg-white shadow-[0_1.5px_0_#4a3728]">
          <div class="overflow-y-auto flex-1 h-full custom-chef-scroll">
            <table class="w-full border-collapse text-xs md:text-sm text-center table-fixed">
              <thead class="sticky top-0 z-10">
                <tr class="bg-[#fef3c7] text-[#4a3728] font-extrabold h-11 border-b-2 border-[#4a3728]">
                  <th class="border-r border-[#4a3728] w-16">ID</th>
                  <th class="border-r border-[#4a3728] w-20">โต๊ะ</th>
                  <th class="border-r border-[#4a3728] text-left pl-4">รายการอาหาร</th>
                  <th class="border-r border-[#4a3728] w-20">จำนวน</th>
                  <th class="w-28">สถานะ</th>
                </tr>
              </thead>
              <tbody id="history-tbody">
                <!-- Rendered via JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- แถบด้านล่าง: ปุ่มย้อนกลับ -->
      <div class="flex justify-start items-center border-t border-[#dfd5c6] pt-4 mt-3">
        <button onclick="switchChefView('queue')" 
                class="h-12 bg-white border-2 border-[#4a3728] hover:bg-[#fef9c3] font-black px-10 rounded-2xl text-[#4a3728] text-base shadow-[0_3px_0_#4a3728] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer flex items-center justify-center">
          กลับไปหน้าคิว
        </button>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- DETAIL MODAL: ป็อปอัปแสดงรายละเอียด -->
    <!-- ======================================================== -->
    <div id="chef-detail-modal" class="hidden absolute inset-0 bg-[#4a3728]/45 backdrop-blur-[4px] items-center justify-center p-6 z-40">
      <div class="bg-white border-2 border-[#4a3728] rounded-[32px] p-7 w-full max-w-[840px] shadow-[0_25px_35px_-5px_rgba(74,55,40,0.35)] flex flex-col justify-between gap-6 relative">
        
        <!-- ปุ่มปิดมุมขวาบน -->
        <button onclick="closeDetailModal()" class="absolute top-5 right-5 w-8 h-8 rounded-full border-1.5 border-[#4a3728] bg-white text-[#4a3728] font-black hover:bg-[#fef9c3] transition cursor-pointer flex items-center justify-center">✕</button>

        <div class="flex flex-col gap-5 pt-1">
          
          <!-- ข้อความแสดง ID ด้านบนสุด -->
          <div>
            <span class="bg-[#fef3c7] border-1.5 border-[#d97706] text-[#a16207] font-black text-xs px-3 py-1 rounded-full shadow-[0_1px_0_#d97706]">
              ORDER ID: <span id="detail-modal-top-id">005</span>
            </span>
          </div>

          <!-- 1. แถบสรุปคำสั่งซื้อทรงมนแคปซูล -->
          <div class="border-2 border-[#4a3728] rounded-2xl overflow-hidden shadow-[0_1.5px_0_#4a3728]">
            <table class="w-full border-collapse text-xs md:text-sm text-center table-fixed">
              <thead>
                <tr class="bg-[#fef3c7] text-[#4a3728] font-extrabold h-10 border-b-2 border-[#4a3728]">
                  <th class="border-r border-[#4a3728] w-20">ID</th>
                  <th class="border-r border-[#4a3728] w-24">โต๊ะ</th>
                  <th class="border-r border-[#4a3728] text-left pl-4">รายการอาหาร</th>
                  <th class="border-r border-[#4a3728] w-20">จำนวน</th>
                  <th class="w-32">สถานะ</th>
                </tr>
              </thead>
              <tbody>
                <tr class="bg-white h-12">
                  <td class="border-r border-[#e8decb] font-bold text-[#716155]" id="detail-id">005</td>
                  <td class="border-r border-[#e8decb] font-black text-[#ea580c] text-base bg-[#fff9f5]" id="detail-table">T05</td>
                  <td class="border-r border-[#e8decb] text-left pl-4 font-black text-[#2d221b]" id="detail-menu">ทงคตสึราเมง</td>
                  <td class="border-r border-[#e8decb] font-black text-base text-[#2d221b]" id="detail-qty">1</td>
                  <td class="p-2 font-black text-sm" id="detail-status">
                    <!-- แสดงสถานะผ่าน JS -->
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- 2. กล่องรายละเอียดการปรุงและท็อปปิ้ง เส้นประสีเหลืองทอง -->
          <div class="bg-[#fffdf0] border-2 border-dashed border-[#facc15] p-5 rounded-2xl space-y-2">
            <div class="flex items-center gap-1.5 font-black text-[#4a3728] text-sm">
              <span>📝</span>
              <span>รายละเอียดการปรุงและท็อปปิ้ง:</span>
            </div>
            <div id="detail-customization" class="text-xs md:text-sm text-[#4a3728] pl-2 font-bold space-y-1">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>

        <!-- 3. Action Buttons & ปุ่มปิดหน้าต่าง -->
        <div class="flex flex-col gap-3 pt-2">
          <div id="detail-actions" class="w-full flex justify-center items-center gap-4">
            <!-- Dynamic Buttons will be inserted here -->
          </div>

          <div class="flex justify-start border-t border-[#dfd5c6] pt-3 mt-1">
            <button onclick="closeDetailModal()" 
                    class="h-10 bg-white border-2 border-[#4a3728] hover:bg-[#fef9c3] font-black px-6 rounded-xl text-[#4a3728] text-xs shadow-[0_1.5px_0_#4a3728] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">
              ปิดหน้าต่าง
            </button>
          </div>
        </div>

      </div>
    </div>

    <!-- ======================================================== -->
    <!-- FOOD SLIP MODAL: ใบรายการอาหารสำหรับส่งโต๊ะ -->
    <!-- ======================================================== -->
    <div id="food-slip-modal" class="hidden absolute inset-0 bg-[#4a3728]/45 backdrop-blur-[4px] items-center justify-center p-4 z-50">
      <div class="bg-white w-[390px] border-2 border-[#4a3728] rounded-[28px] p-6 shadow-[0_25px_35px_-5px_rgba(74,55,40,0.35)] flex flex-col justify-between gap-3">
        <div>
          <div class="text-center border-b-2 border-dashed border-[#4a3728] pb-2 mb-2.5">
            <h3 class="font-black text-lg text-[#4a3728] tracking-widest">FOOD SLIP</h3>
            <p class="text-[11px] font-extrabold text-[#716155] mt-0.5">ใบรายการอาหารสำหรับส่งโต๊ะ</p>
          </div>

          <div class="space-y-1 text-xs border-b border-dashed border-[#dfd5c6] pb-2 mb-2.5 font-bold">
            <div class="flex justify-between text-sm">
              <span class="text-[#716155]">TABLE:</span>
              <span id="slip-table" class="text-[#ea580c] font-black text-base">T05</span>
            </div>
            <div class="flex justify-between text-xs text-[#8c7a6b]">
              <span>ITEM ID:</span>
              <span id="slip-id">#005</span>
            </div>
            <div class="flex justify-between text-xs text-[#8c7a6b]">
              <span>TIME:</span>
              <span id="slip-time">19:30</span>
            </div>
          </div>

          <div class="border-b-2 border-dashed border-[#4a3728] pb-3 mb-2 space-y-1.5">
            <div class="flex justify-between font-black text-base text-[#2d221b]">
              <span id="slip-menu">ทงคตสึราเมง</span>
              <span id="slip-qty" class="text-[#ea580c]">x1</span>
            </div>
            <div id="slip-details" class="text-xs text-[#716155] pl-2 space-y-1 font-bold">
              <!-- Options & Toppings -->
            </div>
          </div>
        </div>

        <div class="flex gap-2.5 mt-1">
          <button onclick="printFoodSlip()" 
                  class="flex-1 h-11 bg-[#ea580c] border-2 border-[#9a3412] rounded-xl text-white font-black text-xs shadow-[0_2px_0_#9a3412] hover:bg-[#c2410c] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer flex items-center justify-center">
            พิมพ์ใบจำลอง
          </button>
          <button onclick="closeFoodSlip()" 
                  class="flex-1 h-11 bg-white border-2 border-[#4a3728] rounded-xl text-[#4a3728] font-black text-xs shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer flex items-center justify-center">
            ปิด
          </button>
        </div>
      </div>
    </div>

  </div>

  <script>
    let queueOrders = [];
    let historyOrders = [];
    let currentSelectedOrder = null;
    let activeChefView = 'queue';

    function switchChefView(view) {
      activeChefView = view;
      if (view === 'queue') {
        document.getElementById('view-queue').classList.remove('hidden');
        document.getElementById('view-history').classList.add('hidden');
      } else {
        document.getElementById('view-queue').classList.add('hidden');
        document.getElementById('view-history').classList.remove('hidden');
      }
      closeDetailModal();
    }

    function fetchChefOrders() {
      fetch('/chef/api/orders')
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            queueOrders = data.queueOrders || [];
            historyOrders = data.historyOrders || [];
            renderQueueTable();
            renderHistoryTable();

            if (currentSelectedOrder) {
              const updated = [...queueOrders, ...historyOrders].find(o => o.order_item_id === currentSelectedOrder.order_item_id);
              if (updated) {
                currentSelectedOrder = updated;
                updateDetailModalContent(updated);
              }
            }
          }
        })
        .catch(err => console.error('Chef fetch error:', err));
    }

    function padId(id) {
      return String(id).padStart(3, '0');
    }

    // Render ตารางคิวรายการอาหาร (8 แถว) พร้อมคอลัมน์โต๊ะสีส้มอ่อนละมุน
    function renderQueueTable() {
      const tbody = document.getElementById('queue-tbody');
      tbody.replaceChildren();

      const totalSlots = Math.max(8, queueOrders.length);

      for (let i = 0; i < totalSlots; i++) {
        const item = queueOrders[i];
        const tr = document.createElement('tr');
        tr.className = 'border-b border-[#e8decb] h-[58px] transition';

        if (item) {
          tr.classList.add('hover:bg-[#fffbeb]', 'cursor-pointer');
          tr.onclick = () => openDetailModal(item.order_item_id);

          const tdId = document.createElement('td');
          tdId.className = 'border-r border-[#e8decb] font-bold text-[#716155] align-middle';
          tdId.textContent = padId(item.order_item_id);

          const tdTable = document.createElement('td');
          tdTable.className = 'border-r border-[#e8decb] font-black text-[#ea580c] text-base align-middle bg-[#fff9f5]';
          tdTable.textContent = item.table_number;

          const tdName = document.createElement('td');
          tdName.className = 'border-r border-[#e8decb] text-left pl-4 align-middle';
          const nameDiv = document.createElement('div');
          nameDiv.className = 'font-black text-[#2d221b]';
          nameDiv.textContent = item.menu_name;
          tdName.appendChild(nameDiv);

          const summaryDetail = [item.options_text, item.toppings_text].filter(Boolean).join(' | ');
          if (summaryDetail) {
            const detailDiv = document.createElement('div');
            detailDiv.className = 'text-[11px] text-[#8c7a6b] font-bold';
            detailDiv.textContent = summaryDetail;
            tdName.appendChild(detailDiv);
          }

          const tdQty = document.createElement('td');
          tdQty.className = 'border-r border-[#e8decb] font-black text-base text-[#2d221b] align-middle';
          tdQty.textContent = item.quantity;

          const tdStatus = document.createElement('td');
          const isPreparing = item.status === 'prepare';
          tdStatus.className = `p-2 font-black text-xs md:text-sm align-middle ${isPreparing ? 'text-[#c2410c]' : 'text-[#0284c7]'}`;
          tdStatus.textContent = isPreparing ? 'กำลังทำ' : 'อยู่ในคิว';

          tr.append(tdId, tdTable, tdName, tdQty, tdStatus);
        } else {
          for (let j = 0; j < 5; j++) {
            const td = document.createElement('td');
            if (j === 1) td.className = 'border-r border-[#e8decb] bg-[#fff9f5] align-middle';
            else if (j < 4) td.className = 'border-r border-[#e8decb] align-middle';
            tr.appendChild(td);
          }
        }
        tbody.appendChild(tr);
      }
    }

    // Render ตารางประวัติรายการ (8 แถว)
    function renderHistoryTable() {
      const tbody = document.getElementById('history-tbody');
      tbody.replaceChildren();

      const totalSlots = Math.max(8, historyOrders.length);

      for (let i = 0; i < totalSlots; i++) {
        const item = historyOrders[i];
        const tr = document.createElement('tr');
        tr.className = 'border-b border-[#e8decb] h-[58px] transition';

        if (item) {
          tr.classList.add('hover:bg-[#fffbeb]', 'cursor-pointer');
          tr.onclick = () => openDetailModal(item.order_item_id);

          const tdId = document.createElement('td');
          tdId.className = 'border-r border-[#e8decb] font-bold text-[#716155] align-middle';
          tdId.textContent = padId(item.order_item_id);

          const tdTable = document.createElement('td');
          tdTable.className = 'border-r border-[#e8decb] font-black text-[#ea580c] text-base align-middle bg-[#fff9f5]';
          tdTable.textContent = item.table_number;

          const tdName = document.createElement('td');
          tdName.className = 'border-r border-[#e8decb] text-left pl-4 align-middle';
          const nameDiv = document.createElement('div');
          nameDiv.className = 'font-black text-[#2d221b]';
          nameDiv.textContent = item.menu_name;
          tdName.appendChild(nameDiv);

          const summaryDetail = [item.options_text, item.toppings_text].filter(Boolean).join(' | ');
          if (summaryDetail) {
            const detailDiv = document.createElement('div');
            detailDiv.className = 'text-[11px] text-[#8c7a6b] font-bold';
            detailDiv.textContent = summaryDetail;
            tdName.appendChild(detailDiv);
          }

          const tdQty = document.createElement('td');
          tdQty.className = 'border-r border-[#e8decb] font-black text-base text-[#2d221b] align-middle';
          tdQty.textContent = item.quantity;

          const tdStatus = document.createElement('td');
          tdStatus.className = 'p-2 font-black text-xs md:text-sm text-[#059669] align-middle';
          tdStatus.textContent = 'เสร็จสิ้น';

          tr.append(tdId, tdTable, tdName, tdQty, tdStatus);
        } else {
          for (let j = 0; j < 5; j++) {
            const td = document.createElement('td');
            if (j === 1) td.className = 'border-r border-[#e8decb] bg-[#fff9f5] align-middle';
            else if (j < 4) td.className = 'border-r border-[#e8decb] align-middle';
            tr.appendChild(td);
          }
        }
        tbody.appendChild(tr);
      }
    }

    // Modal รายละเอียด
    function openDetailModal(orderItemId) {
      const all = [...queueOrders, ...historyOrders];
      const item = all.find(o => o.order_item_id === orderItemId);
      if (!item) return;

      currentSelectedOrder = item;
      updateDetailModalContent(item);
      const modal = document.getElementById('chef-detail-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeDetailModal() {
      const modal = document.getElementById('chef-detail-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      currentSelectedOrder = null;
    }

    function updateDetailModalContent(item) {
      document.getElementById('detail-modal-top-id').textContent = padId(item.order_item_id);
      document.getElementById('detail-id').textContent = padId(item.order_item_id);
      document.getElementById('detail-table').textContent = item.table_number;
      document.getElementById('detail-menu').textContent = item.menu_name;
      document.getElementById('detail-qty').textContent = item.quantity;

      const statusContainer = document.getElementById('detail-status');
      statusContainer.replaceChildren();
      const statusSpan = document.createElement('span');
      statusSpan.className = 'font-black';
      if (item.status === 'queue') {
        statusSpan.classList.add('text-[#0284c7]');
        statusSpan.textContent = 'อยู่ในคิว';
      } else if (item.status === 'prepare') {
        statusSpan.classList.add('text-[#c2410c]');
        statusSpan.textContent = 'กำลังทำ';
      } else {
        statusSpan.classList.add('text-[#059669]');
        statusSpan.textContent = 'เสร็จสิ้น';
      }
      statusContainer.appendChild(statusSpan);

      const customDiv = document.getElementById('detail-customization');
      customDiv.replaceChildren();

      if (item.options_text) {
        const optDiv = document.createElement('div');
        const optLabel = document.createElement('span');
        optLabel.className = 'font-extrabold text-[#2d221b]';
        optLabel.textContent = 'ตัวเลือก: ';
        optDiv.append(optLabel, document.createTextNode(item.options_text));
        customDiv.appendChild(optDiv);
      }
      if (item.toppings_text) {
        const topDiv = document.createElement('div');
        const topLabel = document.createElement('span');
        topLabel.className = 'font-extrabold text-[#2d221b]';
        topLabel.textContent = 'ท็อปปิ้ง: ';
        topDiv.append(topLabel, document.createTextNode(item.toppings_text));
        customDiv.appendChild(topDiv);
      }
      if (!item.options_text && !item.toppings_text) {
        const noCustomSpan = document.createElement('span');
        noCustomSpan.className = 'text-[#8c7a6b] font-medium';
        noCustomSpan.textContent = 'ไม่มีการปรับแต่งเพิ่มเติม';
        customDiv.appendChild(noCustomSpan);
      }

      // Action Buttons (ปรับขนาดปุ่มให้ใหญ่เท่ากันทุกสถานะ ไม่มีสติกเกอร์)
      const actionsDiv = document.getElementById('detail-actions');
      actionsDiv.replaceChildren();

      if (item.status === 'queue') {
        const btn = document.createElement('button');
        btn.onclick = () => updateOrderStatus(item.order_item_id, 'prepare');
        btn.className = 'w-72 h-14 bg-[#ea580c] border-2 border-[#9a3412] hover:bg-[#c2410c] text-white font-black rounded-2xl text-lg shadow-[0_3px_0_#9a3412] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer flex items-center justify-center';
        btn.textContent = 'รับคำสั่งซื้อ';
        actionsDiv.appendChild(btn);
      } else if (item.status === 'prepare') {
        const btnBack = document.createElement('button');
        btnBack.onclick = () => updateOrderStatus(item.order_item_id, 'queue');
        btnBack.className = 'w-56 h-14 bg-[#f0f9ff] border-2 border-[#0284c7] hover:bg-[#e0f2fe] text-[#0284c7] font-black rounded-2xl text-base shadow-[0_2px_0_#0284c7] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer flex items-center justify-center';
        btnBack.textContent = 'ย้ายกลับไปในคิว';

        const btnFinish = document.createElement('button');
        btnFinish.onclick = () => finishOrderAndShowSlip(item.order_item_id);
        btnFinish.className = 'w-56 h-14 bg-[#ea580c] border-2 border-[#9a3412] hover:bg-[#c2410c] text-white font-black rounded-2xl text-base shadow-[0_3px_0_#9a3412] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer flex items-center justify-center';
        btnFinish.textContent = 'ทำเสร็จแล้ว';

        actionsDiv.append(btnBack, btnFinish);
      } else if (item.status === 'finish') {
        const btnQueue = document.createElement('button');
        btnQueue.onclick = () => updateOrderStatus(item.order_item_id, 'queue');
        btnQueue.className = 'w-56 h-14 bg-white border-2 border-[#4a3728] hover:bg-[#fef9c3] text-[#4a3728] font-black rounded-2xl text-base shadow-[0_3px_0_#4a3728] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer flex items-center justify-center';
        btnQueue.textContent = 'นำกลับไปอยู่ในคิว';

        const btnPrint = document.createElement('button');
        btnPrint.onclick = () => showFoodSlip(currentSelectedOrder);
        btnPrint.className = 'w-56 h-14 bg-[#fef3c7] border-2 border-[#d97706] hover:bg-[#fef08a] text-[#a16207] font-black rounded-2xl text-base shadow-[0_3px_0_#d97706] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer flex items-center justify-center';
        btnPrint.textContent = 'พิมพ์ใบเมนูซ้ำ';

        actionsDiv.append(btnQueue, btnPrint);
      }
    }

    function updateOrderStatus(orderItemId, nextStatus) {
      fetch('/chef/api/update-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ order_item_id: orderItemId, next_status: nextStatus })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          fetchChefOrders();
          closeDetailModal();
        } else {
          alert('ไม่สามารถอัปเดตสถานะได้');
        }
      });
    }

    function finishOrderAndShowSlip(orderItemId) {
      fetch('/chef/api/update-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ order_item_id: orderItemId, next_status: 'finish' })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          const itemToSlip = currentSelectedOrder;
          closeDetailModal();
          fetchChefOrders();
          if (itemToSlip) {
            showFoodSlip(itemToSlip);
          }
        }
      });
    }

    function showFoodSlip(item) {
      document.getElementById('slip-table').textContent = item.table_number;
      document.getElementById('slip-id').textContent = '#' + padId(item.order_item_id);
      document.getElementById('slip-time').textContent = new Date(item.order_item_time).toLocaleTimeString('th-TH');
      document.getElementById('slip-menu').textContent = item.menu_name;
      document.getElementById('slip-qty').textContent = `x${item.quantity}`;

      const detailsContainer = document.getElementById('slip-details');
      detailsContainer.replaceChildren();

      if (item.options_text) {
        item.options_text.split(', ').forEach(opt => {
          const div = document.createElement('div');
          div.textContent = `• ${opt}`;
          detailsContainer.appendChild(div);
        });
      }
      if (item.toppings_text) {
        const header = document.createElement('div');
        header.className = 'font-bold pt-1 text-[#4a3728]';
        header.textContent = 'ท็อปปิ้ง:';
        detailsContainer.appendChild(header);

        item.toppings_text.split(', ').forEach(top => {
          const div = document.createElement('div');
          div.className = 'pl-2 text-[#ea580c]';
          div.textContent = `+ ${top}`;
          detailsContainer.appendChild(div);
        });
      }

      const modal = document.getElementById('food-slip-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeFoodSlip() {
      const modal = document.getElementById('food-slip-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function printFoodSlip() {
      alert('🖨️ [จำลองการพิมพ์] ใบรายการอาหารสำหรับพนักงานเสิร์ฟได้ถูกพิมพ์เรียบร้อยแล้ว');
      closeFoodSlip();
    }

    fetchChefOrders();
    setInterval(fetchChefOrders, 3000);
  </script>
</body>
</html>
