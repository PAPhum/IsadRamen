    function getMenuDescription(name) {
      const cleanName = (name || '').trim();
      return menuDescriptions[cleanName] || 'เมนูยอดนิยม ปรุงสดใหม่ทุกออเดอร์ด้วยวัตถุดิบคุณภาพดี';
    }

    let currentCategoryId = <%= categories[0] ? categories[0].category_id : 1 %>;
    let currentMenuPage = 1;
    const itemsPerPage = 6;

    let currentCart = [];

    let editingCartIndex = null;
    let selectedMenu = null;
    let modalQuantity = 1;
    let selectedOptionsMap = {};
    let selectedToppingsMap = {};

    function switchCategory(catId, page = 1) {
      currentCategoryId = catId;
      currentMenuPage = page;

      document.querySelectorAll('.category-tab').forEach(tab => {
        tab.className = 'category-tab bg-white text-[#4a3728] border-2 border-[#4a3728] shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] font-black px-5 py-2 rounded-xl text-sm transition hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none cursor-pointer';
      });
      const activeTab = document.getElementById('cat-tab-' + catId);
      if (activeTab) {
        activeTab.className = 'category-tab bg-[#ea580c] border-2 border-[#9a3412] text-white shadow-[0_2px_0_#9a3412] font-black px-5 py-2 rounded-xl text-sm transition hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none cursor-pointer';
      }

      renderMenuGrid();
    }

    // Render รายการอาหาร (จัดเลย์เอาต์ใหม่ ไม่ให้มีช่องว่างโหวง ข้อความอ่านง่ายเต็มตา)
    function renderMenuGrid() {
      const container = document.getElementById('menu-grid');
      container.replaceChildren();

      const filtered = allMenuItems.filter(item => item.category_id === currentCategoryId);
      const totalPages = Math.max(1, Math.ceil(filtered.length / itemsPerPage));

      if (currentMenuPage > totalPages) currentMenuPage = totalPages;
      if (currentMenuPage < 1) currentMenuPage = 1;

      const startIndex = (currentMenuPage - 1) * itemsPerPage;
      const pageItems = filtered.slice(startIndex, startIndex + itemsPerPage);

      pageItems.forEach(item => {
        const card = document.createElement('div');
        card.className = 'border-2 border-[#dfd5c6] hover:border-[#4a3728] p-2.5 cursor-pointer bg-white text-center rounded-[20px] shadow-[0_2px_0_#dfd5c6] hover:shadow-[0_3px_0_#4a3728] hover:bg-[#fff9f5] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition flex flex-col justify-between h-full min-h-0';
        card.onclick = () => onMenuItemClick(item);

        const imgPath = item.menu_image ? '/images/' + item.menu_image : '/images/shoyu.jpg';

        // 1. กรอบรูปภาพ สัดส่วนสวยงาม คมชัด
        const imgContainer = document.createElement('div');
        imgContainer.className = 'w-full aspect-[4/3] max-h-[110px] overflow-hidden rounded-xl border border-[#dfd5c6] bg-gray-50 flex items-center justify-center mb-1.5 shadow-xs';

        const img = document.createElement('img');
        img.src = imgPath;
        img.alt = item.menu_name;
        img.className = 'w-full h-full object-cover transition duration-200 hover:scale-105';
        imgContainer.appendChild(img);

        // 2. ชื่ออาหาร อยู่ติดใต้รูปภาพทันที
        const nameP = document.createElement('p');
        nameP.className = 'font-black text-xs md:text-sm text-[#2d221b] leading-tight w-full truncate';
        nameP.textContent = item.menu_name;

        // 3. คำอธิบายอาหาร ปรับขนาดให้อ่านง่าย สบายตา ไม่เล็กเกินไป
        const descP = document.createElement('p');
        descP.className = 'text-[10px] md:text-[11px] text-[#716155] font-medium leading-normal line-clamp-2 w-full px-1 my-auto text-center';
        descP.textContent = getMenuDescription(item.menu_name);

        // 4. แถบราคา
        const priceContainer = document.createElement('div');
        priceContainer.className = 'w-full pt-1 flex justify-center items-center';
        const priceTag = document.createElement('span');
        priceTag.className = 'text-xs md:text-sm font-black text-[#ea580c] bg-[#fff7ed] border border-[#ffedd5] px-3.5 py-0.5 rounded-full shadow-xs';
        priceTag.textContent = `${item.base_price} ฿`;
        priceContainer.appendChild(priceTag);

        card.append(imgContainer, nameP, descP, priceContainer);
        container.appendChild(card);
      });

      for (let i = pageItems.length; i < itemsPerPage; i++) {
        const emptyBox = document.createElement('div');
        emptyBox.className = 'border border-dashed border-[#dfd5c6] rounded-[20px] p-2.5 invisible';
        container.appendChild(emptyBox);
      }

      document.getElementById('prev-page-btn').disabled = false;
      document.getElementById('next-page-btn').disabled = false;
      document.getElementById('page-indicator').textContent = `${currentMenuPage} / ${totalPages}`;
    }

    function prevMenuPage() {
      if (currentMenuPage > 1) {
        currentMenuPage--;
        renderMenuGrid();
      } else {
        const catIndex = allCategories.findIndex(c => c.category_id === currentCategoryId);
        const prevCatIndex = (catIndex - 1 + allCategories.length) % allCategories.length;
        const prevCatId = allCategories[prevCatIndex].category_id;
        const filteredPrev = allMenuItems.filter(item => item.category_id === prevCatId);
        const prevTotalPages = Math.max(1, Math.ceil(filteredPrev.length / itemsPerPage));
        switchCategory(prevCatId, prevTotalPages);
      }
    }

    function nextMenuPage() {
      const filtered = allMenuItems.filter(item => item.category_id === currentCategoryId);
      const totalPages = Math.max(1, Math.ceil(filtered.length / itemsPerPage));
      if (currentMenuPage < totalPages) {
        currentMenuPage++;
        renderMenuGrid();
      } else {
        const catIndex = allCategories.findIndex(c => c.category_id === currentCategoryId);
        const nextCatIndex = (catIndex + 1) % allCategories.length;
        const nextCatId = allCategories[nextCatIndex].category_id;
        switchCategory(nextCatId, 1);
      }
    }

    function onMenuItemClick(item) {
      if (item.category_id === 1) {
        openCustomizeModal(item);
      } else {
        addDirectItemToCart(item);
      }
    }

    function addDirectItemToCart(item) {
      const existing = currentCart.find(c => c.menu_id === item.menu_id && (!c.selected_options || c.selected_options.length === 0));
      if (existing) {
        existing.quantity += 1;
      } else {
        currentCart.push({
          menu_id: item.menu_id,
          menu_name: item.menu_name,
          category_id: item.category_id,
          base_price: parseFloat(item.base_price),
          unit_price: parseFloat(item.base_price),
          quantity: 1,
          selected_options: [],
          selected_options_text: '',
          selected_toppings: [],
          selected_toppings_text: ''
        });
      }
      renderCartTable();
    }

    function openCustomizeModal(item, existingItem = null, cartIndex = null) {
      selectedMenu = item;
      editingCartIndex = cartIndex;
      modalQuantity = existingItem ? existingItem.quantity : 1;
      selectedOptionsMap = {};
      selectedToppingsMap = {};

      document.getElementById('modal-menu-name').textContent = item.menu_name;
      document.getElementById('modal-menu-desc').textContent = getMenuDescription(item.menu_name);
      document.getElementById('modal-base-price').textContent = item.base_price;
      document.getElementById('modal-img').src = item.menu_image ? '/images/' + item.menu_image : '/images/shoyu.jpg';
      document.getElementById('modal-quantity').textContent = modalQuantity;

      allToppings.forEach(t => {
        const qtyEl = document.getElementById('top_qty_' + t.topping_id);
        if (qtyEl) qtyEl.textContent = '0';
      });

      const catList = ['ความนุ่มเส้น', 'ความข้นซุป', 'ความเผ็ด', 'ต้นหอม'];
      catList.forEach(catName => {
        const catOpts = allOptions.filter(o => o.option_category === catName);
        if (catOpts.length === 0) return;

        let selectedOpt = null;
        if (existingItem && existingItem.selected_options) {
          selectedOpt = catOpts.find(o => existingItem.selected_options.includes(o.option_id));
        }

        if (!selectedOpt) {
          if (catName === 'ความนุ่มเส้น') selectedOpt = catOpts.find(o => o.option_name === 'ปานกลาง') || catOpts[0];
          else if (catName === 'ความข้นซุป') selectedOpt = catOpts.find(o => o.option_name === 'ปานกลาง') || catOpts[0];
          else if (catName === 'ความเผ็ด') selectedOpt = catOpts.find(o => o.option_name === 'ปานกลาง') || catOpts[0];
          else if (catName === 'ต้นหอม') selectedOpt = catOpts.find(o => o.option_name === 'ใส่') || catOpts[0];
        }

        if (selectedOpt) {
          selectOption(catName, selectedOpt.option_id, selectedOpt.option_name);
        }
      });

      if (existingItem && existingItem.selected_toppings) {
        existingItem.selected_toppings.forEach(t => {
          selectedToppingsMap[t.topping_id] = {
            quantity: t.quantity,
            price: t.price,
            topping_name: t.topping_name
          };
          const qtyEl = document.getElementById('top_qty_' + t.topping_id);
          if (qtyEl) qtyEl.textContent = t.quantity;
        });
      }

      calculateModalTotal();
      const modal = document.getElementById('customize-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      const modal = document.getElementById('customize-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      editingCartIndex = null;
    }

    function selectOption(catName, optId, optName) {
      selectedOptionsMap[catName] = { option_id: optId, option_name: optName };

      document.querySelectorAll(`button[data-cat="${catName}"]`).forEach(btn => {
        btn.className = 'opt-button flex-1 py-1.5 px-2 text-xs font-black rounded-lg border-2 border-[#4a3728] bg-white text-[#4a3728] shadow-[0_1.5px_0_#4a3728] hover:bg-[#fef9c3] transition cursor-pointer';
      });

      const activeBtn = document.getElementById('opt-btn-' + optId);
      if (activeBtn) {
        activeBtn.className = 'opt-button flex-1 py-1.5 px-2 text-xs font-black rounded-lg border-2 border-[#eab308] bg-[#fef08a] text-[#a16207] shadow-[0_1.5px_0_#ca8a04] transition cursor-pointer';
      }
    }

    function changeToppingQty(toppingId, price, delta) {
      const current = selectedToppingsMap[toppingId] ? selectedToppingsMap[toppingId].quantity : 0;
      const next = Math.max(0, current + delta);

      const topObj = allToppings.find(t => t.topping_id === toppingId);
      const topName = topObj ? topObj.topping_name : '';

      if (next === 0) {
        delete selectedToppingsMap[toppingId];
      } else {
        selectedToppingsMap[toppingId] = {
          quantity: next,
          price: price,
          topping_name: topName
        };
      }

      const qtyEl = document.getElementById('top_qty_' + toppingId);
      if (qtyEl) qtyEl.textContent = next;

      calculateModalTotal();
    }

    function changeModalQuantity(delta) {
      modalQuantity = Math.max(1, modalQuantity + delta);
      document.getElementById('modal-quantity').textContent = modalQuantity;
      calculateModalTotal();
    }

    function calculateModalTotal() {
      let toppingSum = 0;
      for (const id in selectedToppingsMap) {
        toppingSum += selectedToppingsMap[id].price * selectedToppingsMap[id].quantity;
      }
      const unitPrice = parseFloat(selectedMenu.base_price) + toppingSum;
      const total = unitPrice * modalQuantity;
      document.getElementById('modal-total-price').textContent = total;
    }

    function saveCustomizeToCart() {
      const selectedOptsList = Object.values(selectedOptionsMap);
      const optIds = selectedOptsList.map(o => o.option_id);
      const optNames = selectedOptsList.map(o => o.option_name).join(' / ');

      const toppingsList = [];
      const toppingTextParts = [];
      let toppingSum = 0;

      for (const tId in selectedToppingsMap) {
        const item = selectedToppingsMap[tId];
        toppingsList.push({
          topping_id: parseInt(tId),
          topping_name: item.topping_name,
          quantity: item.quantity,
          price: item.price
        });
        toppingTextParts.push(`${item.topping_name} x${item.quantity}`);
        toppingSum += item.price * item.quantity;
      }

      const unitPrice = parseFloat(selectedMenu.base_price) + toppingSum;

      const cartItemData = {
        menu_id: selectedMenu.menu_id,
        menu_name: selectedMenu.menu_name,
        category_id: selectedMenu.category_id,
        base_price: parseFloat(selectedMenu.base_price),
        unit_price: unitPrice,
        quantity: modalQuantity,
        selected_options: optIds,
        selected_options_text: optNames,
        selected_toppings: toppingsList,
        selected_toppings_text: toppingTextParts.join(', ')
      };

      if (editingCartIndex !== null && currentCart[editingCartIndex]) {
        currentCart[editingCartIndex] = cartItemData;
      } else {
        currentCart.push(cartItemData);
      }

      renderCartTable();
      closeModal();
    }

    function renderCartTable() {
      const tbody = document.getElementById('cart-tbody');
      const emptyState = document.getElementById('cart-empty-state');
      tbody.replaceChildren();

      let grandTotal = 0;

      // จัดการ Empty State ให้ดูเป็นมิตรเมื่อไม่มีรายการอาหาร
      if (currentCart.length === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }

      for (let i = 0; i < 8; i++) {
        const item = currentCart[i];
        const tr = document.createElement('tr');
        tr.className = 'border-b border-[#e8decb]';
        tr.style.height = '12.5%';

        if (item) {
          tr.classList.add('hover:bg-[#fffbeb]', 'transition');
          grandTotal += item.unit_price * item.quantity;
          
          const isCustomized = item.category_id === 1;

          const tdName = document.createElement('td');
          tdName.className = 'border-r border-[#e8decb] text-left pl-3 font-bold text-[#2d221b] cursor-pointer align-middle';
          if (isCustomized) {
            tdName.title = 'แตะเพื่อแก้ไข';
          }
          tdName.onclick = () => editCartItem(i);

          const divName = document.createElement('div');
          divName.className = 'line-clamp-1';
          divName.textContent = item.menu_name;

          if (isCustomized) {
            const star = document.createElement('span');
            star.className = 'text-xs text-[#ea580c] font-black ml-1';
            star.textContent = '*';
            divName.appendChild(star);
          }
          tdName.appendChild(divName);

          const tdQty = document.createElement('td');
          tdQty.className = 'border-r border-[#e8decb] font-black text-[#2d221b] align-middle';
          tdQty.textContent = item.quantity;

          const tdPlus = document.createElement('td');
          tdPlus.className = 'border-r border-[#e8decb] font-black text-sm text-[#4a3728] cursor-pointer hover:bg-[#fef9c3] active:bg-[#fef08a] align-middle transition';
          tdPlus.textContent = '+';
          tdPlus.onclick = () => changeCartQty(i, 1);

          const tdMinus = document.createElement('td');
          tdMinus.className = 'border-r border-[#e8decb] font-black text-sm text-[#4a3728] cursor-pointer hover:bg-[#fef9c3] active:bg-[#fef08a] align-middle transition';
          tdMinus.textContent = '-';
          tdMinus.onclick = () => changeCartQty(i, -1);

          const tdRemove = document.createElement('td');
          tdRemove.className = 'bg-[#fee2e2] hover:bg-[#fecaca] text-[#dc2626] font-black text-xs cursor-pointer active:bg-[#fca5a5] align-middle transition';
          tdRemove.textContent = 'ลบ';
          tdRemove.onclick = () => removeCartItem(i);

          tr.append(tdName, tdQty, tdPlus, tdMinus, tdRemove);
        } else {
          for (let j = 0; j < 5; j++) {
            const td = document.createElement('td');
            if (j < 4) td.className = 'border-r border-[#e8decb] align-middle';
            tr.appendChild(td);
          }
        }
        tbody.appendChild(tr);
      }

      document.getElementById('cart-total-price').textContent = grandTotal;
      document.getElementById('submit-order-btn').disabled = (currentCart.length === 0);
    }

    function changeCartQty(index, delta) {
      if (currentCart[index]) {
        currentCart[index].quantity += delta;
        if (currentCart[index].quantity <= 0) {
          currentCart.splice(index, 1);
        }
        renderCartTable();
      }
    }

    function removeCartItem(index) {
      currentCart.splice(index, 1);
      renderCartTable();
    }

    function editCartItem(index) {
      const item = currentCart[index];
      if (!item) return;
      if (item.category_id === 1) {
        const fullMenu = allMenuItems.find(m => m.menu_id === item.menu_id) || item;
        openCustomizeModal(fullMenu, item, index);
      }
    }

    let waitTimer = null;

    function submitOrder() {
      if (currentCart.length === 0) {
        alert('กรุณาเลือกรายการอาหารก่อนสั่ง');
        return;
      }

      const submitBtn = document.getElementById('submit-order-btn');
      submitBtn.disabled = true;

      fetch(`/customer/${tableNumber}/order`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cart: currentCart })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          currentCart = [];
          renderCartTable();

          const waitModal = document.getElementById('wait-modal');
          waitModal.classList.remove('hidden');
          waitModal.classList.add('flex');
          if (waitTimer) clearTimeout(waitTimer);
          waitTimer = setTimeout(() => {
            closeWaitModal();
          }, 5000);
        } else {
          alert('เกิดข้อผิดพลาด: ' + (data.message || 'ไม่สามารถสั่งอาหารได้'));
          submitBtn.disabled = false;
        }
      })
      .catch(err => {
        console.error('Submit order error:', err);
        alert('เกิดข้อผิดพลาดในการเชื่อมต่อ');
        submitBtn.disabled = false;
      });
    }

    function closeWaitModal() {
      if (waitTimer) clearTimeout(waitTimer);
      const waitModal = document.getElementById('wait-modal');
      waitModal.classList.add('hidden');
      waitModal.classList.remove('flex');
      document.getElementById('submit-order-btn').disabled = (currentCart.length === 0);
    }

    renderMenuGrid();
    renderCartTable();
  </script>
</body>
</html>