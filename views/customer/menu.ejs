<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>สั่งอาหาร - โต๊ะ <%= table.table_number %> | Koumiya Ramen</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: { fontFamily: { sans: ['Prompt', 'sans-serif'] } }
      }
    }
  </script>
  <style>
    .custom-chef-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .custom-chef-scroll::-webkit-scrollbar-track {
      background: #fffdfa;
      border-radius: 8px;
    }
    .custom-chef-scroll::-webkit-scrollbar-thumb {
      background-color: #fde047;
      border: 1.5px solid #ca8a04;
      border-radius: 8px;
    }
    .custom-chef-scroll::-webkit-scrollbar-thumb:hover {
      background-color: #facc15;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-[#fff7ed] via-[#fef3c7] to-[#f5f5f4] min-h-screen flex items-center justify-center p-4 select-none text-[#4a3728] font-sans">

  <!-- Tablet Frame -->
  <div class="w-full max-w-[1080px] h-[740px] bg-white border-2 border-[#4a3728] rounded-[28px] p-5 relative flex flex-col justify-between shadow-[0_10px_25px_-5px_rgba(74,55,40,0.06)] overflow-hidden">
    
    <!-- Main Content Area -->
    <div class="flex-1 flex gap-4 overflow-hidden min-h-0">
      
      <!-- ฝั่งซ้าย: หมวดหมู่และเมนูอาหาร (62%) -->
      <div class="w-[62%] flex flex-col justify-between pr-1 h-full min-h-0">
        <div class="flex-1 flex flex-col min-h-0">
          
          <!-- Category Tabs & Brand Indicator Header -->
          <div class="flex justify-between items-center mb-2.5">
            <div class="flex gap-2.5 overflow-x-auto pb-0.5">
              <% categories.forEach((cat, idx) => { %>
                <button onclick="switchCategory(<%= cat.category_id %>, 1)" 
                        id="cat-tab-<%= cat.category_id %>"
                        class="category-tab <%= idx === 0 ? 'bg-[#ea580c] border-2 border-[#9a3412] text-white shadow-[0_2px_0_#9a3412]' : 'bg-white text-[#4a3728] border-2 border-[#4a3728] shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3]' %> font-black px-5 py-2 rounded-xl text-sm transition hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none cursor-pointer">
                  <%= cat.category_name %>
                </button>
              <% }) %>
            </div>

            <!-- ป้ายบาลานซ์พื้นที่ด้านบนขวา -->
            <div class="hidden md:flex items-center gap-1.5 bg-[#fef3c7]  text-xs font-black text-[#a46700] shadow-xs">
              
            </div>
          </div>

          <!-- Menu Grid (2 Rows x 3 Cols = 6 Items) -->
          <div id="menu-grid" class="grid grid-cols-3 grid-rows-2 gap-3 flex-1 min-h-0">
            <!-- Rendered by JS based on active category & page -->
          </div>
        </div>

        <!-- Pagination Bar -->
        <div class="flex justify-between items-center mt-2.5 pt-2 border-t border-[#dfd5c6] pb-1.5">
          <button id="prev-page-btn" onclick="prevMenuPage()" 
                  class="h-10 bg-white border-2 border-[#4a3728] font-black px-8 rounded-xl text-xs text-[#4a3728] shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">
            ย้อนกลับ
          </button>
          <span id="page-indicator" class="text-xs text-[#716155] font-black bg-[#fffbeb] px-4 py-1.5 rounded-full border border-[#fde68a]">1 / 1</span>
          <button id="next-page-btn" onclick="nextMenuPage()" 
                  class="h-10 bg-white border-2 border-[#4a3728] font-black px-8 rounded-xl text-xs text-[#4a3728] shadow-[0_2px_0_#4a3728] hover:bg-[#fef9c3] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">
            ถัดไป
          </button>
        </div>
      </div>

      <!-- ฝั่งขวา: ปุ่มประวัติ + ตาราง Cart (38%) -->
      <div class="w-[38%] flex flex-col justify-between border-2 border-[#4a3728] rounded-[20px] p-3.5 bg-[#fffdfa] h-full min-h-0">
        <div class="flex-1 flex flex-col min-h-0">
          <!-- ปุ่มประวัติการสั่ง/ชำระเงิน -->
          <a href="/customer/<%= table.table_number %>/history" 
             class="block w-full bg-white border-2 border-[#4a3728] hover:bg-[#fef9c3] font-black py-2.5 rounded-xl text-center text-xs text-[#4a3728] mb-3 shadow-[0_2px_0_#4a3728] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition">
            ประวัติการสั่ง/ชำระเงิน
          </a>

          <!-- Cart Table Container -->
          <div class="flex-1 border-2 border-[#4a3728] rounded-2xl overflow-hidden flex flex-col min-h-0 bg-white shadow-[0_1.5px_0_#4a3728] relative">
            <table class="w-full h-full border-collapse text-xs text-center table-fixed">
              <thead>
                <tr class="bg-[#fef3c7] font-extrabold text-[#4a3728] h-9 border-b-2 border-[#4a3728]">
                  <th class="border-r border-[#4a3728] p-1 text-left pl-3">รายการอาหาร</th>
                  <th class="border-r border-[#4a3728] p-1 w-12">จำนวน</th>
                  <th class="border-r border-[#4a3728] p-1 w-9">เพิ่ม</th>
                  <th class="border-r border-[#4a3728] p-1 w-9">ลด</th>
                  <th class="p-1 w-12">ลบ</th>
                </tr>
              </thead>
              <tbody id="cart-tbody" class="h-full">
                <!-- Rows rendered here -->
              </tbody>
            </table>

            <!-- Empty State แสดงเมื่อไม่มีรายการอาหารในตะกร้า -->
            <div id="cart-empty-state" class="hidden absolute inset-0 top-9 bg-white/95 flex flex-col items-center justify-center p-4 text-center">
              <div class="w-14 h-14 rounded-2xl bg-[#fffbeb] border border-[#fde68a] flex items-center justify-center text-3xl mb-2 shadow-xs">
                🍜
              </div>
              <p class="font-black text-sm text-[#4a3728]">ยังไม่มีรายการในตะกร้า</p>
              <p class="text-[11px] font-bold text-[#8c7a6b] mt-0.5">แตะเลือกเมนูทางซ้ายเพื่อเริ่มสั่งอาหาร</p>
            </div>
          </div>
        </div>

        <!-- Cart Summary & Submit Order Button -->
        <div class="mt-3 pt-2">
          <div class="border-2 border-[#4a3728] rounded-xl py-2 px-4 mb-2.5 flex justify-between items-center bg-[#fffbeb] shadow-[0_1.5px_0_#4a3728]">
            <span class="text-xs font-black text-[#4a3728]">รวมทั้งหมด:</span>
            <span class="text-2xl font-black text-[#ea580c]"><span id="cart-total-price">0</span> ฿</span>
          </div>
          <button onclick="submitOrder()" 
                  id="submit-order-btn"
                  class="w-full h-12 bg-[#ea580c] border-2 border-[#9a3412] hover:bg-[#c2410c] text-white font-black rounded-xl text-base shadow-[0_3px_0_#9a3412] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none disabled:opacity-45 disabled:cursor-not-allowed disabled:shadow-none transition cursor-pointer flex items-center justify-center gap-1.5">
            สั่งอาหาร
          </button>
        </div>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- Customize Modal (สำหรับราเมง) -->
    <!-- ======================================================== -->
    <div id="customize-modal" class="hidden absolute inset-0 bg-[#4a3728]/45 backdrop-blur-[4px] items-center justify-center p-5 z-50">
      <div class="bg-white border-2 border-[#4a3728] rounded-[32px] p-6 w-full max-w-[860px] h-[640px] shadow-[0_25px_35px_-5px_rgba(74,55,40,0.35)] flex flex-col justify-between">
        
        <div class="flex gap-6 flex-1 overflow-hidden min-h-0">
          
          <!-- ฝั่งซ้าย: รูป + ชื่ออาหาร + คำอธิบาย + ราคาเริ่มต้น -->
          <div class="w-1/3 flex flex-col items-center justify-center border-r border-[#dfd5c6] pr-4">
            <div class="w-full aspect-square max-h-44 overflow-hidden rounded-2xl border-2 border-[#4a3728] mb-2 shadow-[0_2px_0_#4a3728]">
              <img id="modal-img" src="/images/shoyu.jpg" class="w-full h-full object-cover">
            </div>
            
            <div class="bg-[#fffbeb] border-2 border-[#4a3728] w-full text-center py-1.5 font-black text-base text-[#4a3728] rounded-xl shadow-[0_1.5px_0_#4a3728]" id="modal-menu-name">
              โชยุราเมง
            </div>

            <!-- คำอธิบายอาหารใน Modal ชัดเจน ไม่เบียด -->
            <div class="w-full mt-2 p-2.5 bg-[#fffdf0] border border-[#fde68a] rounded-xl text-center shadow-xs">
              <p id="modal-menu-desc" class="text-xs font-bold text-[#716155] leading-relaxed">
                <!-- คำอธิบายจะถูกแทรกโดย JS -->
              </p>
            </div>

            <p class="text-xs font-black text-[#716155] mt-2">ราคาเริ่มต้น: <span id="modal-base-price" class="text-[#ea580c] font-black text-sm">0</span> ฿</p>
          </div>

          <!-- ฝั่งขวา: ตารางปรับแต่งฟรี + Topping -->
          <div class="w-2/3 flex flex-col justify-between overflow-y-auto pl-2 space-y-3 custom-chef-scroll pr-1">
            
            <!-- ตารางปรับแต่งฟรี -->
            <div>
              <div class="text-center font-black text-xs mb-1.5 bg-[#fef3c7] text-[#4a3728] py-1 rounded-lg border border-[#fde68a]">ตัวเลือกการปรับแต่ง</div>
              <div class="border-2 border-[#4a3728] rounded-xl overflow-hidden shadow-[0_1.5px_0_#4a3728]">
                <table class="w-full border-collapse text-xs text-center">
                  <tbody>
                    <% 
                      const optionCategories = ['ความนุ่มเส้น', 'ความข้นซุป', 'ความเผ็ด', 'ต้นหอม'];
                      optionCategories.forEach(catName => {
                        const catOpts = options.filter(o => o.option_category === catName);
                    %>
                      <tr class="border-b border-[#e8decb] last:border-b-0">
                        <td class="border-r border-[#e8decb] font-bold p-1.5 bg-[#fffdfa] w-28 text-left pl-3 text-[#4a3728]">
                          <%= catName %>
                        </td>
                        <td class="p-1.5 bg-white">
                          <div class="flex gap-1.5 justify-center">
                            <% catOpts.forEach(opt => { %>
                              <button type="button" 
                                      onclick="selectOption('<%= catName %>', <%= opt.option_id %>, '<%= opt.option_name %>')"
                                      id="opt-btn-<%= opt.option_id %>"
                                      data-cat="<%= catName %>"
                                      data-optid="<%= opt.option_id %>"
                                      class="opt-button flex-1 py-1.5 px-2 text-xs font-black rounded-lg border-2 border-[#4a3728] bg-white text-[#4a3728] shadow-[0_1.5px_0_#4a3728] hover:bg-[#fef9c3] transition cursor-pointer">
                                <%= opt.option_name %>
                              </button>
                            <% }) %>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- ตาราง Topping -->
            <div>
              <div class="text-center font-black text-xs mb-1.5 bg-[#fef3c7] text-[#4a3728] py-1 rounded-lg border border-[#fde68a]">ท็อปปิ้งเพิ่มเติม</div>
              <div class="border-2 border-[#4a3728] rounded-xl overflow-hidden shadow-[0_1.5px_0_#4a3728]">
                <table class="w-full border-collapse text-xs text-center">
                  <tbody>
                    <% toppings.forEach(top => { %>
                      <tr class="border-b border-[#e8decb] last:border-b-0 bg-white">
                        <td class="border-r border-[#e8decb] p-1.5 font-bold text-left pl-3 w-1/2 text-[#4a3728]">
                          <%= top.topping_name %> <span class="text-[#ea580c] font-black">(+<%= top.price %>฿)</span>
                        </td>
                        <td class="border-r border-[#e8decb] p-1 w-12">
                          <button type="button" onclick="changeToppingQty(<%= top.topping_id %>, <%= top.price %>, -1)" 
                                  class="w-7 h-7 bg-white border border-[#4a3728] rounded-lg font-black text-sm text-[#4a3728] hover:bg-[#fef9c3] active:bg-[#fef08a] cursor-pointer shadow-xs">-</button>
                        </td>
                        <td class="border-r border-[#e8decb] p-1 w-14 font-black text-sm text-[#4a3728]">
                          <span id="top_qty_<%= top.topping_id %>">0</span>
                        </td>
                        <td class="p-1 w-12">
                          <button type="button" onclick="changeToppingQty(<%= top.topping_id %>, <%= top.price %>, 1)" 
                                  class="w-7 h-7 bg-white border border-[#4a3728] rounded-lg font-black text-sm text-[#4a3728] hover:bg-[#fef9c3] active:bg-[#fef08a] cursor-pointer shadow-xs">+</button>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- จำนวนชามที่ต้องการสั่ง -->
            <div class="flex items-center justify-between bg-[#fffdf0] border-2 border-dashed border-[#facc15] p-2.5 rounded-xl">
              <span class="font-black text-xs text-[#4a3728] pl-2">จำนวนชาม:</span>
              <div class="flex items-center gap-3 pr-2">
                <button type="button" onclick="changeModalQuantity(-1)" 
                        class="w-8 h-8 bg-white border-2 border-[#4a3728] rounded-lg font-black text-base text-[#4a3728] hover:bg-[#fef9c3] shadow-[0_1.5px_0_#4a3728] active:translate-y-0.5 active:shadow-none cursor-pointer">-</button>
                <span id="modal-quantity" class="font-black text-base w-8 text-center text-[#4a3728]">1</span>
                <button type="button" onclick="changeModalQuantity(1)" 
                        class="w-8 h-8 bg-white border-2 border-[#4a3728] rounded-lg font-black text-base text-[#4a3728] hover:bg-[#fef9c3] shadow-[0_1.5px_0_#4a3728] active:translate-y-0.5 active:shadow-none cursor-pointer">+</button>
              </div>
            </div>

          </div>
        </div>

        <!-- แถบด้านล่างของ Modal -->
        <div class="flex justify-between items-center border-t border-[#dfd5c6] pt-3 mt-2">
          <button type="button" onclick="closeModal()" 
                  class="h-11 bg-white border-2 border-[#4a3728] hover:bg-[#fef9c3] text-[#4a3728] font-black px-8 rounded-xl text-xs shadow-[0_2px_0_#4a3728] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">
            ย้อนกลับ
          </button>
          <span class="font-black text-xl text-[#4a3728]">
            รวม <span id="modal-total-price" class="text-2xl text-[#ea580c]">0</span> ฿
          </span>
          <button type="button" onclick="saveCustomizeToCart()" 
                  class="h-11 bg-[#ea580c] border-2 border-[#9a3412] hover:bg-[#c2410c] text-white font-black px-8 rounded-xl text-xs shadow-[0_2px_0_#9a3412] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">
            เพิ่มลงตะกร้า
          </button>
        </div>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- Wait Screen Modal ("รออาหารสักครู่") -->
    <!-- ======================================================== -->
    <div id="wait-modal" class="hidden absolute inset-0 bg-[#4a3728]/45 backdrop-blur-[4px] items-center justify-center p-4 z-50 cursor-pointer"
         onclick="closeWaitModal()">
      <div class="bg-white border-2 border-[#4a3728] rounded-[32px] p-8 w-[420px] shadow-[0_25px_35px_-5px_rgba(74,55,40,0.35)] flex flex-col items-center justify-center text-center">
        <div class="text-6xl mb-3 animate-bounce">⏳</div>
        <h1 class="text-3xl font-black text-[#4a3728] mb-2 tracking-tight">รออาหารสักครู่</h1>
        <p class="text-[#8c7a6b] text-xs font-bold mb-4">ระบบได้ส่งรายการไปยังห้องครัวเรียบร้อยแล้ว<br>(จะปิดอัตโนมัติใน 5 วินาที)</p>
        
        <div class="bg-[#fef3c7] border-2 border-[#4a3728] px-5 py-1.5 rounded-full text-xs font-black text-[#4a3728] shadow-[0_1.5px_0_#4a3728]">
          โต๊ะ <%= table.table_number %>
        </div>
      </div>
    </div>

  </div>

  <script>
    const rawCategories = <%- JSON.stringify(categories) %>;
    const rawMenuItems = <%- JSON.stringify(menuItems) %>;
    const allOptions = <%- JSON.stringify(options) %>;
    const allToppings = <%- JSON.stringify(toppings) %>;
    const tableNumber = '<%= table.table_number %>';

    // กรองเมนูซ้ำออก
    const seenNames = new Set();
    const allMenuItems = rawMenuItems.filter(item => {
      const trimmed = (item.menu_name || '').trim();
      if (!trimmed || seenNames.has(trimmed)) {
        return false;
      }
      seenNames.add(trimmed);
      return true;
    });

    const allCategories = rawCategories;

    // คำอธิบายอาหารรสชาติต้นตำรับแท้ สมบูรณ์แบบทุกเมนู
    const menuDescriptions = {
      // 🍜 ราเมง
      'โชยุราเมง': 'น้ำซุปซีอิ๊วญี่ปุ่นดั้งเดิม หอมกรุ่นกลิ่นปลาแห้งและโชยุหมักธรรมชาติ',
      'ทงคตสึราเมง': 'ซุปกระดูกหมูสูตรฮากาตะ เคี่ยวไฟอ่อน 12 ชม. เข้มข้น นุ่มละมุนลิ้น',
      'ชาชูเมง': 'ซุปกระดูกหมูกลมกล่อม เสิร์ฟพร้อมหมูชาชูย่างไฟชิ้นโตเนื้อนุ่มละลาย',
      'ชาชูเมน': 'ซุปกระดูกหมูกลมกล่อม เสิร์ฟพร้อมหมูชาชูย่างไฟชิ้นโตเนื้อนุ่มละลาย',
      'ชิโอะราเมง': 'น้ำซุปเกลือทะเลญี่ปุ่น รสชาติใสเบาสะอาดตา สัมผัสนุ่ม ชุ่มคอ สดชื่น',
      'ชิโอะเลม่อนราเมง': 'ซุปเกลือทะเลสูตรพิเศษ ผสานรสเปรี้ยวและกลิ่นหอมชื่นใจจากเลม่อนสด',
      'สไปซี่มิโซะราเมง': 'ซุปเต้าเจี้ยวญี่ปุ่นผสานน้ำมันพริกเผารายู รสชาติเผ็ดร้อนกลมกล่อมลงตัว',
      'มิโซะราเมง': 'ซุปเต้าเจี้ยวญี่ปุ่นแท้ 3 ชนิด รสชาติเข้มข้น หอมมันกลมกล่อม อบอุ่น',
      'ต้มยำชาชูเมง': 'การผสานซุปราเมงเข้มข้นกับรสต้มยำน้ำข้นไทยแท้ เปรี้ยวเผ็ดจัดจ้านถึงเครื่อง',
      'ฮะจังเมง': 'ราเมงซุปโชยุใสสูตรคลาสสิก เสิร์ฟพร้อมชาชูนุ่ม หน่อไม้ และลูกชิ้นปลา',
      'ทันทันเมน': 'ราเมงซุปงาขาวบดเข้มข้น หอมมัน ท็อปหมูสับผัดซอสเสฉวนรสเผ็ดจัดจ้าน',
      'เนกิราเมง': 'ราเมงซุปโชยุกลมกล่อม ท็อปด้วยต้นหอมญี่ปุ่นซอยคลุกน้ำมันงาพูนชาม',
      'คาเรราเมง': 'ราเมงซุปแกงกะหรี่ญี่ปุ่นเคี่ยวเข้มข้น หอมเครื่องเทศ เสิร์ฟร้อนกลมกล่อม',
      'มาเซโซบะ': 'บะหมี่แห้งคลุกสไตล์นาโกย่า ท็อปหมูสับรสเผ็ด สาหร่าย และไข่แดงดิบ',
      'ยากิโซบะ': 'เส้นโซบะเหนียวนุ่มผัดซอสหวานญี่ปุ่น หมูสามชั้น กะหล่ำปลี โรยปลาแห้ง',
