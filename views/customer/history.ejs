<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ประวัติการสั่งอาหาร - โต๊ะ <%= table.table_number %> | Koumiya Ramen</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: { fontFamily: { sans: ['Prompt', 'sans-serif'] } }
      }
    }
  </script>
</head>
<body class="bg-gradient-to-br from-[#fff7ed] via-[#fef3c7] to-[#f5f5f4] min-h-screen flex items-center justify-center p-4 select-none text-[#4a3728] font-sans">

  <!-- Tablet Frame -->
  <div class="w-full max-w-[1080px] h-[740px] bg-white border-2 border-[#4a3728] rounded-[28px] p-6 relative flex flex-col justify-between shadow-[0_10px_25px_-5px_rgba(74,55,40,0.06)] overflow-hidden">
    
    <div class="flex-1 flex flex-col overflow-hidden min-h-0">
      
      <!-- Top Header -->
      <div class="flex justify-between items-center border-b-2 border-[#4a3728] pb-3 mb-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl border-2 border-[#4a3728] bg-[#fef3c7] flex items-center justify-center text-2xl shadow-[0_2px_0_#4a3728]">📜</div>
          <h1 class="text-2xl font-black text-[#4a3728]">รายการอาหารที่สั่ง (Order History)</h1>
          <span class="bg-[#fef3c7] text-[#a46700] text-xs font-extrabold px-3 py-1 rounded-full border border-[#fde68a]">
            โต๊ะ: <%= table.table_number %>
          </span>
        </div>
      </div>

      <!-- ตารางประวัติรายการที่สั่ง (ตรึง 8 แถวพอดี) -->
      <div class="flex-1 border-2 border-[#4a3728] rounded-2xl overflow-hidden flex flex-col min-h-0 bg-white shadow-[0_1.5px_0_#4a3728]">
        <table class="w-full h-full border-collapse text-xs md:text-sm text-center table-fixed">
          <thead>
            <tr class="bg-[#fef3c7] text-[#4a3728] font-extrabold h-11 border-b-2 border-[#4a3728]">
              <th class="border-r border-[#4a3728] w-16">ลำดับ</th>
              <th class="border-r border-[#4a3728] text-left pl-4">รายการอาหาร</th>
              <th class="border-r border-[#4a3728] w-20">จำนวน</th>
              <th class="border-r border-[#4a3728] w-32">สถานะ</th>
              <th class="w-28 text-center">ราคา</th>
            </tr>
          </thead>
          <tbody class="h-full">
            <% 
              const totalSlots = Math.max(8, items.length);
              for (let i = 0; i < totalSlots; i++) { 
                const item = items[i];
            %>
              <tr class="border-b border-[#e8decb] hover:bg-[#fffbeb] transition <%= totalSlots === 8 ? 'h-[12.5%]' : '' %>">
                <td class="border-r border-[#e8decb] text-[#716155] font-bold align-middle"><%= item ? (i + 1) : '' %></td>
                <td class="border-r border-[#e8decb] text-left pl-4 align-middle">
                  <% if (item) { %>
                    <div class="font-black text-[#2d221b]"><%= item.menu_name %></div>
                    <% if (item.options_text || item.toppings_text) { %>
                      <div class="text-[11px] text-[#8c7a6b] font-bold mt-0.5">
                        <%= [item.options_text, item.toppings_text].filter(Boolean).join(' | ') %>
                      </div>
                    <% } %>
                  <% } %>
                </td>
                <td class="border-r border-[#e8decb] font-black text-base text-[#2d221b] align-middle"><%= item ? item.quantity : '' %></td>
                <td class="border-r border-[#e8decb] font-black text-xs md:text-sm align-middle">
                  <% if (item) { %>
                    <% if (item.status === 'finish') { %>
                      <span class="text-[#059669]">เสร็จสิ้น</span>
                    <% } else if (item.status === 'prepare') { %>
                      <span class="text-[#c2410c]">กำลังทำ</span>
                    <% } else { %>
                      <span class="text-[#0284c7]">อยู่ในคิว</span>
                    <% } %>
                  <% } %>
                </td>
                <td class="text-center font-black text-[#ea580c] align-middle"><%= item ? `${item.total_item_price} ฿` : '' %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- แถบสรุปเงินด้านล่าง -->
    <div class="flex justify-between items-center border-t border-[#dfd5c6] pt-4 mt-3.5">
      <a href="/customer/<%= table.table_number %>/menu" 
         class="h-12 bg-white border-2 border-[#4a3728] hover:bg-[#fef9c3] font-black px-10 rounded-2xl text-[#4a3728] text-base shadow-[0_3px_0_#4a3728] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition flex items-center justify-center">
        ย้อนกลับ
      </a>

      <div class="border-2 border-[#4a3728] rounded-2xl py-2 px-6 bg-[#fffbeb] shadow-[0_1.5px_0_#4a3728] flex items-center gap-3">
        <span class="text-sm font-black text-[#716155]">ยอดรวมทั้งหมด:</span>
        <span class="font-black text-3xl text-[#ea580c]">
          <%= grandTotal %> ฿
        </span>
      </div>

      <button onclick="openNoticeModal()" 
              class="h-12 bg-[#ea580c] border-2 border-[#9a3412] hover:bg-[#c2410c] font-black px-12 rounded-2xl text-white text-base shadow-[0_3px_0_#9a3412] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer flex items-center justify-center">
        ชำระเงิน
      </button>
    </div>

    <!-- ======================================================== -->
    <!-- Modal เมื่อกดชำระเงิน -->
    <!-- ======================================================== -->
    <div id="checkout-notice-modal" 
         class="hidden absolute inset-0 bg-[#4a3728]/45 backdrop-blur-[4px] items-center justify-center p-6 z-50">
      
      <div class="bg-white border-2 border-[#4a3728] rounded-[32px] p-10 w-[520px] shadow-[0_25px_35px_-5px_rgba(74,55,40,0.35)] flex flex-col items-center justify-center text-center relative">
        
        <div class="w-20 h-20 rounded-2xl border-2 border-[#4a3728] bg-[#fef3c7] flex items-center justify-center text-4xl mb-4 shadow-[0_2px_0_#4a3728]">
          💳
        </div>
        
        <h1 class="text-3xl font-black text-[#4a3728] mb-1 tracking-tight">นำ Payment Card ไป</h1>
        <h1 class="text-4xl font-black text-[#ea580c] mb-3 tracking-tight">ชำระเงินที่แคชเชียร์</h1>
        <p class="text-[#8c7a6b] text-xs font-bold mb-6">กรุณานำการ์ดประจำโต๊ะของคุณไปติดต่อที่เคาน์เตอร์แคชเชียร์เพื่อชำระเงิน<br>(หน้าต่างนี้จะปิดอัตโนมัติใน 10 วินาที)</p>

        <div class="flex justify-between items-center w-full pt-3 border-t border-[#dfd5c6]">
          <button onclick="closeNoticeModal()" 
                  class="h-10 bg-white border-2 border-[#4a3728] hover:bg-[#fef9c3] font-black px-6 rounded-xl text-xs text-[#4a3728] shadow-[0_2px_0_#4a3728] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-none transition cursor-pointer">
            ย้อนกลับ
          </button>

          <div class="bg-[#fef3c7] border border-[#fde68a] px-4 py-1.5 rounded-full text-xs font-black text-[#a46700]">
            โต๊ะ <%= table.table_number %>
          </div>
        </div>

      </div>
    </div>

  </div>

  <script>
    let noticeTimer = null;

    function openNoticeModal() {
      const modal = document.getElementById('checkout-notice-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      if (noticeTimer) clearTimeout(noticeTimer);
      noticeTimer = setTimeout(() => {
        closeNoticeModal();
      }, 10000);
    }

    function closeNoticeModal() {
      if (noticeTimer) clearTimeout(noticeTimer);
      const modal = document.getElementById('checkout-notice-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  </script>
</body>
</html>