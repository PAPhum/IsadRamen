<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>หน้าเริ่มต้น - โต๊ะ <%= table.table_number %> | IsadRamen</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4 font-sans select-none">

  <!-- กรอบหน้าจอแท็บเล็ต แนวนอน 1024x768 ตาม Wireframe -->
  <div class="w-full max-w-[1024px] h-[700px] md:h-[740px] bg-white border-4 border-black relative flex flex-col items-center justify-center shadow-2xl rounded-sm">
    
    <!-- ปุ่มกลางจอ: กดเพื่อเลือกเมนู -->
    <a href="/customer/<%= table.table_number %>/menu" 
       class="group text-center px-12 py-16 rounded-3xl hover:bg-gray-50 transition transform hover:scale-105 active:scale-95 cursor-pointer">
      <div class="text-7xl mb-4">🍜</div>
      <h1 class="text-5xl md:text-6xl font-black text-black tracking-tight group-hover:text-red-700 transition">
        กดเพื่อเลือกเมนู
      </h1>
      <p class="text-gray-400 font-medium text-lg mt-4">แตะหน้าจอเพื่อเริ่มสั่งอาหาร</p>
    </a>

    <!-- หมายเลขโต๊ะ มุมขวาล่าง ตาม Wireframe -->
    <div class="absolute bottom-4 right-4 bg-gray-200 border-2 border-gray-400 px-6 py-2 text-base font-bold text-black rounded-lg shadow-sm">
      โต๊ะ <%= table.table_number %>
    </div>
  </div>

</body>
</html>